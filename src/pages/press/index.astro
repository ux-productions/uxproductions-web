---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import GameTitle from '../../components/GameTitle.astro';
import { GAMES } from '../../data/games';
import { SITE } from '../../data/site';
---
<Base
  title="Press kit"
  description="Press kit for UX Productions and its games The Perfect Robot, The Perfect Murder and The Perfect Race: fact sheets, screenshots, trailers, logos and contact."
  lang="en"
  path="/press/"
>
  <div class="wrap">
    <header class="page-head">
      <span class="label">For press and creators</span>
      <h1>Press kit</h1>
      <p>Everything you need to write about or stream our games. All screenshots, trailers and logos may be used in coverage of the games.</p>
    </header>

    <div class="split press-grid">
      <section class="prose">
        <h2>Studio fact sheet</h2>
        {/* A list rather than a table: Astro's compiler re-opened the mailto link after a
            table here, which turned the next two sections into one big link. */}
        <dl class="sheet">
          <div><dt>Studio</dt><dd>{SITE.legalName}</dd></div>
          <div><dt>Based in</dt><dd>{SITE.city}, Sweden</dd></div>
          <div><dt>Founded</dt><dd>{SITE.founded}</dd></div>
          <div><dt>Games</dt><dd>{GAMES.map((g) => g.name).join(', ')}</dd></div>
          <div><dt>Platforms</dt><dd>Steam (Windows), iOS, Android, web browser</dd></div>
          <div><dt>Website</dt><dd><a href="/">uxproductions.se</a></dd></div>
          <div><dt>Press contact</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        </dl>
        <h2>About the studio</h2>
        <p>UX Productions is a small game studio in Eskilstuna, Sweden, founded in 2013. It has made games, learning apps for Swedish schools and tools for Unity developers. Today it makes the Perfect games: games that each do one thing as well as the studio can make it, with no ads and no subscriptions. Three are out, and The Perfect Part is coming to iOS, Android and Steam.</p>
        <h2>Studio logo</h2>
        <p><a href="/press/ux-productions-logo.png" download>UX Productions logo (PNG, 1300x1300)</a></p>
        <h2>Keys and interviews</h2>
        <p>For review keys, interviews or anything else, email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      </section>

      <section>
        <h2 class="kits-h">Game press kits</h2>
        <div class="kits">
          {GAMES.map((g) => (
            <a class="kit" href={`/press/${g.slug}/`}>
              <Picture src={g.card ?? g.hero} alt="" widths={[360, 680, 960].filter((w) => w <= (g.card ?? g.hero).width)} sizes="(max-width: 900px) 100vw, 364px" formats={['avif', 'webp']} />
              {/* Each game's name as the game sets it, as on the games' own cards. */}
              <span><b class="kit-name"><GameTitle game={g} logoSizes="132px" /></b><small>{g.genre.en}</small></span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .press-grid { padding-block: 24px 88px; }
  .press-grid .prose h2:first-child, .kits-h { margin-top: 0; }
  .sheet { margin: 1em 0 1.4em; font-size: 15px; }
  .sheet div { display: grid; grid-template-columns: 9.5em minmax(0, 1fr); gap: 12px; padding: 8px 10px; border-bottom: 1px solid var(--line); }
  .sheet dt { color: var(--text); font-weight: 600; }
  .sheet dd { margin: 0; color: var(--text-dim); overflow-wrap: anywhere; }
  .kits-h { font: 600 1.25rem/1.2 var(--display); letter-spacing: -0.01em; margin-bottom: 16px; }
  .kits { display: grid; gap: 16px; }
  .kit { display: block; background: var(--plate); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; color: var(--text); text-decoration: none; }
  .kit:hover { border-color: var(--line-strong); color: var(--text); }
  .kit img { aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .kit span { display: block; padding: 12px 16px 14px; container-type: inline-size; }
  .kit-name { display: flex; align-items: center; min-height: 2.4rem; margin-bottom: 2px; }
  .kit-name :global(.gt-murder) { font-size: min(1.35rem, 100cqi / 11.6); }
  .kit-name :global(.gt-race) { font-size: min(.95rem, 100cqi / 16.8); }
  .kit-name :global(.gt-robot) { width: 120px; margin: -6px 0 -4px -6px; }
  .kit-name :global(.gt-part) { width: 100px; }
  .kit small { display: block; color: var(--text-muted); font-size: 14px; }
</style>
