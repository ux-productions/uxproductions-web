---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import GameTitle from '../../components/GameTitle.astro';
import Icon from '../../components/Icon.astro';
import { GAMES, type Game } from '../../data/games';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return GAMES.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}
const { game } = Astro.props as { game: Game };

// The kit's files live in public/press/<slug>/; list them as they are.
const dir = path.join(process.cwd(), 'public', 'press', game.slug);
const files = fs.readdirSync(dir).sort();
const sizeOf = (f: string) => `${(fs.statSync(path.join(dir, f)).size / 1048576).toFixed(1)} MB`;
const zip = files.find((f) => f.endsWith('.zip'));
const images = files.filter((f) => /\.(jpe?g|png)$/i.test(f));
// On wide screens, a column count that divides the number of files: no half-empty last row.
const cols = [4, 3, 6].find((c) => images.length % c === 0);
const nice = (f: string) =>
  f.replace(/\.(jpe?g|png)$/i, '').replace(/^screenshot-\d*[-_]?/, 'Screenshot: ').replace(/[-_]/g, ' ');

const videoFiles = game.videos.map((v) => ({
  ...v,
  size: `${(fs.statSync(path.join(process.cwd(), 'public', v.file)).size / 1048576).toFixed(1)} MB`,
}));
---
<Base
  title={`${game.name} press kit`}
  description={`Press kit for ${game.name}: fact sheet, description, features, screenshots, trailers, logos and key art to download, and press contact.`}
  lang="en"
  path={`/press/${game.slug}/`}
  image={`/og/${game.slug}.jpg`}
  imageAlt={game.name}
  fonts={game.theme === 'robot' ? [] : [game.theme]}
>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/press/">Press</a> / {game.name}</nav>
      <p class="label kit-label">Press kit</p>
      <h1 class="kit-title"><GameTitle game={game} logoSizes="(max-width: 640px) 260px, 360px" eager /><span class="visually-hidden"> press kit</span></h1>
      <p>{game.tagline.en}</p>
      <div class="btns" style="margin-top:20px">
        {zip && <a class="btn primary" href={`/press/${game.slug}/${zip}`} download><Icon name="download" />Download everything ({sizeOf(zip)})</a>}
        <a class="btn" href={`/games/${game.slug}/`}>Game page</a>
      </div>
    </header>

    <div class="split kit-grid">
      <div class="prose">
        <h2>Description</h2>
        {game.intro.en.map((p) => <p>{p}</p>)}
        <h2>Features</h2>
        <ul>{game.features.en.map((f) => <li><strong>{f.title}:</strong> {f.text}</li>)}</ul>
        {videoFiles.length > 0 && (
          <>
            <h2>Trailers</h2>
            <ul>{videoFiles.map((v) => <li><a href={v.file} download>{v.title.en}</a> (MP4, 1280x720, {v.seconds} s, {v.size})</li>)}</ul>
            <p>Need them at 1920x1080? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
          </>
        )}
        <h2>Images</h2>
        <p>Click to download the full-size file.</p>
      </div>
      <aside>
        <div class="side-box">
          <h2>Fact sheet</h2>
          <dl>
            <dt>Developer and publisher</dt><dd>{SITE.legalName}, {SITE.city}, Sweden</dd>
            {game.facts.en.filter((f) => f.label !== 'Developer').map((f) => (<><dt>{f.label}</dt><dd>{f.value}</dd></>))}
            <dt>Store pages</dt>
            <dd>{game.stores.map((s, i) => (<>{i > 0 && ', '}<a href={s.url} rel="noopener">{{ steam: 'Steam', appstore: 'App Store', googleplay: 'Google Play', web: 'Website' }[s.kind]}</a></>))}</dd>
            <dt>Press contact</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </dl>
        </div>
      </aside>
    </div>

    <div class="downloads" style={cols ? `--cols:${cols}` : undefined}>
      {images.map((f) => (
        <a href={`/press/${game.slug}/${f}`} download class="dl">
          <img src={`/press/${game.slug}/thumbs/${f.replace(/\.(jpe?g|png)$/i, '.jpg')}`} alt="" loading="lazy" decoding="async" />
          <span class="name">{nice(f)} <small>{sizeOf(f)}</small></span>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .kit-grid { padding-top: 24px; }
  /* The game's own name as the page title (the h1 says "... press kit" to everyone). */
  .kit-label { margin: 18px 0 0; }
  .page-head h1.kit-title { container-type: inline-size; max-width: none; margin: 10px 0 14px; }
  .kit-title :global(.gt-robot) { width: min(360px, 70vw); margin: -14px 0 -10px -12px; }
  .kit-title :global(.gt-murder) { font-size: min(3.5rem, 100cqi / 11.6); }
  .kit-title :global(.gt-race) { font-size: min(2.25rem, 100cqi / 16.8); }
  .kit-grid .prose h2:first-child { margin-top: 0; }
  .downloads { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 10px; padding-block: 8px 88px; }
  @media (min-width: 1100px) { .downloads[style*="--cols"] { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); } }
  .dl { display: flex; flex-direction: column; gap: 8px; padding: 10px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--plate); color: var(--text); text-decoration: none; font-size: 15px; text-transform: none; }
  .dl:hover { border-color: var(--accent); color: var(--text); }
  .dl img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 3px; background: var(--ground); }
  .dl .name::first-letter { text-transform: uppercase; }
  .dl small { color: var(--text-muted); margin-left: 6px; }
</style>
