---
import { Picture } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GameTitle from '../../components/GameTitle.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import { gameBySlug } from '../../data/games';
import { publishedNews } from '../../data/news';
import { SITE, formatDate } from '../../data/site';

export async function getStaticPaths() {
  const posts = await publishedNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'news'> };
const { Content } = await render(post);
const game = post.data.game ? gameBySlug(post.data.game) : undefined;
// Share images are 1200x630 crops made by scripts/make-og.py.
const og = post.data.og ?? `/og/news-${post.id}.jpg`;
const url = new URL(`/news/${post.id}/`, SITE.url).href;

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  image: new URL(og, SITE.url).href,
  url,
  mainEntityOfPage: url,
  inLanguage: 'en',
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  ...(game ? { about: { '@id': `${SITE.url}/games/${game.slug}/#game` } } : {}),
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'News', item: `${SITE.url}/news/` },
    { '@type': 'ListItem', position: 2, name: post.data.title, item: url },
  ],
};
---
<Base
  title={post.data.title}
  description={post.data.description}
  lang="en"
  path={`/news/${post.id}/`}
  type="article"
  image={og}
  imageAlt={post.data.imageAlt}
  published={post.data.date}
  jsonld={[article, breadcrumbs]}

  fonts={game && game.theme !== 'robot' ? [game.theme] : []}
>
  <div class="wrap">
    <header class="page-head narrow">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/news/">News</a> / <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'en')}</time></nav>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
    </header>
    <div class="split post-grid">
      <article class="prose post">
        <Picture src={post.data.image} alt={post.data.imageAlt} widths={[720, 1440]} sizes="(max-width: 760px) 100vw, 720px" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
        <Content />
      </article>
      <aside class="post-side">
        {game ? (
          <div class="side-box post-game">
            <h2><GameTitle game={game} logoSizes="200px" /></h2>
            <p>{game.tagline.en}</p>
            <StoreButtons game={game} lang="en">
              <a class="btn" href={`/games/${game.slug}/`}>About the game</a>
            </StoreButtons>
          </div>
        ) : (
          <div class="side-box post-game">
            <h2>UX Productions</h2>
            <p>Releases, updates and sales from the studio.</p>
            <div class="btns"><a class="btn" href="/news/">All news</a></div>
          </div>
        )}
        <p class="post-more"><a href="/news/">All news</a> · <a href="/news/rss.xml">RSS</a></p>
      </aside>
    </div>
  </div>
</Base>

<style>
  .post-grid { padding-bottom: 88px; }
  .post > :global(picture:first-child img), .post > :global(img:first-child) { margin-top: .4em; }
  .post-side { position: sticky; top: 20px; align-self: start; margin-top: .4em; }
  .post-game h2 { font: 700 1.25rem/1.2 var(--display); text-transform: none; letter-spacing: -0.01em; margin-bottom: 6px; container-type: inline-size; }
  .post-game h2 :global(.gt-robot) { width: 200px; margin: -10px 0 -6px -8px; }
  .post-game h2 :global(.gt-murder) { font-size: min(1.5rem, 100cqi / 11.6); }
  .post-game h2 :global(.gt-race) { font-size: min(1rem, 100cqi / 16.8); }
  .post-game p { margin: 0 0 14px; color: var(--text-dim); font-size: 15.5px; }
  .post-more { margin: 14px 0 0; font-size: 15px; color: var(--text-muted); }
</style>
