/**
 * The UX Productions mark as vector paths, traced from the studio logo
 * (public/press/ux-productions-logo.png; the trace stays within a pixel of it),
 * so it is sharp at any size and takes its colour from currentColor.
 * It is decorative: name the link or heading around it.
 *   defs     the shared paths, once per page (Header renders it); every other variant reuses them with <use>
 *   ux       the "UX" letters alone
 *   wordmark "UX" and "PRODUCTIONS" on one line, at the same height
 *   stack    "UX" over "PRODUCTIONS", as in the logo, without the frame
 *   logo     the full logo in its frame
 */
interface Props {
  variant?: 'defs' | 'ux' | 'wordmark' | 'stack' | 'logo';
  class?: string;
}
const { variant = 'ux', class: className } = Astro.props;
const UX = 'M0 0L2 0L279 0L280 0L274 185L274 271L275 410L277 451L280 478L284 501L289 518L293 528L302 541L313 551L319 555L328 559L343 563L353 564L364 564L375 564L383 563L395 559L398 558L398 556L397 450L393 271L387 158L377 0L379 0L662 0L680 46L692 72L721 127L746 172L747 170L754 154L768 121L804 26L812 2L814 1L1074 1L1074 1L1072 5L1036 76L958 224L908 314L862 394L933 522L992 622L1029 683L1029 684L855 684L803 597L771 545L770 545L689 683L688 684L345 684L319 684L291 682L267 679L244 675L213 667L195 661L178 654L160 645L147 637L129 624L111 607L96 590L84 573L72 552L60 526L51 501L42 468L36 437L29 391L22 332L17 279L11 211L5 125L1 49ZM576 243L575 246L576 312L576 381L575 436L573 473L574 476L593 455L612 430L627 405L637 386L645 368L636 349L617 314Z';
