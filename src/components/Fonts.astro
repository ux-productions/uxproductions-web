---
/**
 * Every web font on the site, declared here with the exact files the build emits, so a
 * preload and its @font-face can never point at different URLs.
 *
 * How a page avoids showing a heading in one font and then another:
 *  - Headings, labels and game titles come inside the page. The studio face (Saira
 *    Condensed 700) and the mono labels (IBM Plex Mono 500), only ever set in capitals,
 *    and the two games' title faces (Bodoni Moda 700 for "The Perfect Murder", Press
 *    Start 2P for "THE PERFECT RACE") each have a small subset with just the characters
 *    they use (src/assets/fonts/, made by scripts/make-font-subsets.py from
 *    subsets.json), inlined below as data: URLs: about 12 KB in all. They are declared
 *    after the full faces, so for their characters the browser takes them and never
 *    fetches the full file, and they are there for the first paint on any connection
 *    (font-display: block only ever waits for the decoding). The full faces stay
 *    declared for any other character.
 *  - The body face (Familjen Grotesk, one variable font for 400 to 700, latin) is the one
 *    file every page preloads, with font-display: optional: a font that is not ready
 *    when the page is first drawn is not swapped in later, so text never changes font in
 *    front of the reader. A preload does not guarantee it is ready: on some first visits
 *    that page keeps the body's fallback (measured: every engine on 150 ms / 1.6 Mbps,
 *    WebKit from about 80 ms, Chromium now and then even on fast lines); every later page
 *    has the font from the cache.
 *  - The fallbacks are local fonts with their metrics matched to the web font
 *    (size-adjust, ascent, descent and line gap, computed from the font files), so that
 *    fallback takes almost the same room.
 * latin covers English and Swedish (å, ä, ö); latin-ext loads only for other letters.
 */
import sairaLatin from '@fontsource/saira-condensed/files/saira-condensed-latin-700-normal.woff2?url';
import sairaExt from '@fontsource/saira-condensed/files/saira-condensed-latin-ext-700-normal.woff2?url';
// The body face as one variable font for all its weights (400 to 700).
import bodyLatin from '@fontsource-variable/familjen-grotesk/files/familjen-grotesk-latin-wght-normal.woff2?url';
import bodyExt from '@fontsource-variable/familjen-grotesk/files/familjen-grotesk-latin-ext-wght-normal.woff2?url';
import monoLatin from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import monoExt from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-500-normal.woff2?url';
import bodoniLatin from '@fontsource/bodoni-moda/files/bodoni-moda-latin-700-normal.woff2?url';
import bodoniExt from '@fontsource/bodoni-moda/files/bodoni-moda-latin-ext-700-normal.woff2?url';
import pixelLatin from '@fontsource/press-start-2p/files/press-start-2p-latin-400-normal.woff2?url';
import pixelExt from '@fontsource/press-start-2p/files/press-start-2p-latin-ext-400-normal.woff2?url';
import subsets from '../assets/fonts/subsets.json';

// The inline subsets, as data: URLs.
const inline = import.meta.glob<string>('../assets/fonts/*.woff', { query: '?inline', import: 'default', eager: true });

const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

// The Perfect Race's own correction (its tokens.css): the line box runs from the baseline
// to the cap top, so the pixel face centres true next to anything else.
const PIXEL_METRICS = 'ascent-override:100%;descent-override:0%;line-gap-override:0%;';

const faces: { family: string; weight: number | string; latin: string; ext: string; extra?: string }[] = [
  { family: 'Saira Condensed', weight: 700, latin: sairaLatin, ext: sairaExt },
  { family: 'Familjen Grotesk', weight: '400 700', latin: bodyLatin, ext: bodyExt },
  { family: 'IBM Plex Mono', weight: 500, latin: monoLatin, ext: monoExt },
  { family: 'Bodoni Moda', weight: 700, latin: bodoniLatin, ext: bodoniExt },
  { family: 'Press Start 2P', weight: 400, latin: pixelLatin, ext: pixelExt, extra: PIXEL_METRICS },
];

// A subset's unicode-range: exactly the characters it has, as runs (U+41-5A,U+C4-C5,...).
const rangeOf = (text: string) => {
  const cps = [...new Set([...text].map((c) => c.codePointAt(0)!))].sort((a, b) => a - b);
  const runs: [number, number][] = [];
  for (const cp of cps) {
    const last = runs[runs.length - 1];
    if (last && cp === last[1] + 1) last[1] = cp;
    else runs.push([cp, cp]);
  }
  const hex = (n: number) => n.toString(16).toUpperCase();
  return runs.map(([a, b]) => (a === b ? `U+${hex(a)}` : `U+${hex(a)}-${hex(b)}`)).join(',');
};

// Fallbacks: a local font scaled to the web font's width (size-adjust, from the advance
// widths of typical text in each face), with the web font's own vertical metrics.
// Values from the font files with fontTools; see the README.
const fallbacks: { family: string; weight: number; local: string[]; size: string; ascent: string; descent: string }[] = [
  { family: 'Saira Condensed Fallback', weight: 700, local: ['Arial Narrow Bold', 'ArialNarrow-Bold', 'Arial Narrow'], size: '83.84%', ascent: '135.37%', descent: '52.36%' },
  { family: 'Saira Condensed Fallback Wide', weight: 700, local: ['Arial Bold', 'Arial-BoldMT', 'Arial'], size: '68.75%', ascent: '165.10%', descent: '63.86%' },
  { family: 'Familjen Grotesk Fallback', weight: 400, local: ['Arial', 'ArialMT', 'Roboto'], size: '93.90%', ascent: '109.16%', descent: '23.96%' },
  { family: 'Familjen Grotesk Fallback', weight: 500, local: ['Arial', 'ArialMT', 'Roboto'], size: '96.37%', ascent: '106.36%', descent: '23.35%' },
  { family: 'Familjen Grotesk Fallback', weight: 600, local: ['Arial Bold', 'Arial-BoldMT', 'Roboto Bold', 'Arial'], size: '91.35%', ascent: '112.21%', descent: '24.63%' },
  { family: 'Familjen Grotesk Fallback', weight: 700, local: ['Arial Bold', 'Arial-BoldMT', 'Roboto Bold', 'Arial'], size: '92.45%', ascent: '110.87%', descent: '24.34%' },
  { family: 'IBM Plex Mono Fallback', weight: 500, local: ['Consolas'], size: '109.13%', ascent: '93.92%', descent: '25.20%' },
  { family: 'IBM Plex Mono Fallback Wide', weight: 500, local: ['Menlo Regular', 'Menlo-Regular', 'Courier New', 'CourierNewPSMT'], size: '99.98%', ascent: '102.52%', descent: '27.50%' },
  { family: 'Bodoni Moda Fallback', weight: 700, local: ['Georgia Bold', 'Georgia-Bold', 'Georgia'], size: '94.77%', ascent: '118.71%', descent: '42.21%' },
  { family: 'Press Start 2P Fallback', weight: 400, local: ['Courier New Bold', 'CourierNewPS-BoldMT', 'Courier New'], size: '166.64%', ascent: '60.01%', descent: '0%' },
];

const face = (family: string, weight: number | string, src: string, range: string, display: string, extra = '') =>
  `@font-face{font-family:'${family}';font-style:normal;font-weight:${weight};font-display:${display};src:${src};unicode-range:${range};${extra}}`;

const css =
  faces.flatMap((f) => [face(f.family, f.weight, `url(${f.latin}) format('woff2')`, LATIN, 'optional', f.extra), face(f.family, f.weight, `url(${f.ext}) format('woff2')`, LATIN_EXT, 'optional', f.extra)]).join('') +
  // After the full faces, so the browser takes these first for their characters.
  subsets
    .map((s) => {
      const data = inline[`../assets/fonts/${s.file}`];
      if (!data) throw new Error(`Fonts.astro: run scripts/make-font-subsets.py (no ${s.file})`);
      return face(s.family, s.weight, `url(${data}) format('woff')`, rangeOf(s.text), 'block', s.family === 'Press Start 2P' ? PIXEL_METRICS : '');
    })
    .join('') +
  fallbacks
    .map((f) => `@font-face{font-family:'${f.family}';font-style:normal;font-weight:${f.weight};src:${f.local.map((n) => `local('${n}')`).join(',')};size-adjust:${f.size};ascent-override:${f.ascent};descent-override:${f.descent};line-gap-override:0%}`)
    .join('');

// The one downloaded face every page's first screen needs.
const preloads = [bodyLatin];
---
{preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={css}></style>
