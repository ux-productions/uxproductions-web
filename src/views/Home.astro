---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import GameIcon from '../components/GameIcon.astro';
import GameTitle from '../components/GameTitle.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import Socials from '../components/Socials.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { GAMES, MURDER, ROBOT, platformLabel } from '../data/games';
import PanelArt from '../components/PanelArt.astro';
import Words from '../components/Words.astro';
import { BADGES, FEATURED_GAME, ROBOT_STEAM_RELEASE, SITE, badgeFor, excerpt, formatDate, localize, loopsFor, robotOnSteam, steamRelease, storeLabel, storeShort, t, type Lang } from '../data/site';
import { freshNews } from '../data/news';
import robotKeyArt from '../assets/robot/key-art.jpg';
import robotKeyArtPhone from '../assets/robot/key-art-phone.jpg';
import murderNight from '../assets/murder/harbour-night.jpg';
import murderNightPhone from '../assets/murder/harbour-night-phone.jpg';
import raceNight from '../assets/race/harbour-street-night.jpg';
import raceNightPhone from '../assets/race/harbour-street-night-phone.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const sv = lang === 'sv';
const news = await freshNews();

const title = sv ? 'UX Productions: The Perfect Robot, Murder och Race' : 'UX Productions: The Perfect Robot, Murder and Race';
const description = sv
  ? 'UX Productions är en spelstudio i Eskilstuna. Vi gör The Perfect Robot, The Perfect Murder och The Perfect Race för Steam, mobilen och webbläsaren.'
  : 'UX Productions is a game studio in Eskilstuna, Sweden. We make The Perfect Robot, The Perfect Murder and The Perfect Race for Steam, phones and the browser.';

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: 'UX Productions',
  url: `${SITE.url}/`,
  inLanguage: ['en', 'sv'],
  publisher: { '@id': `${SITE.url}/#organization` },
};

// ---- The Steam launch block in the masthead, while The Perfect Robot has a badge.
// Static text first; the script adds the countdown and switches the words at release.
const launchBadge = badgeFor(ROBOT.slug);
const steamOut = robotOnSteam();
const release = steamRelease(lang);
const outBadge = BADGES.find((b) => b.game === ROBOT.slug && b.from?.getTime() === ROBOT_STEAM_RELEASE.getTime());
// The chip already says "out now", so the sentence says when it came out.
const outNote = sv
  ? `Släpptes på Steam ${release.day}. Finns också på iOS och Android.`
  : `Released on Steam on ${release.day}. Also on iOS and Android.`;
const launch = launchBadge && {
  // A no-break space before the dot: a narrow chip breaks after it, never inside the time.
  chip: steamOut ? launchBadge[lang] : `${launchBadge[lang]} · ${release.time}`,
  note: steamOut
    ? outNote
    : sv ? `Släpps på Steam ${release.day} ${release.time}. Finns redan på iOS och Android.` : `Comes to Steam on ${release.day} at ${release.time}. Already out on iOS and Android.`,
  // What the words become at the release, for a page that is open at that moment.
  after: steamOut ? undefined : { chip: outBadge?.[lang], note: outNote },
};
const steam = ROBOT.stores.find((st) => st.kind === 'steam')!;
const units = sv ? ['Dagar', 'Timmar', 'Min'] : ['Days', 'Hours', 'Min'];

// ---- The three panels. How each game's art sits on wide screens: x and y as a spine
// (x0, y0) and open (x1, y1); and on tablets (xm, ym). The Robot places its key art by
// two of its own points instead (see the stage CSS): the floating head centred on its
// spine, and the green robot right of the copy when open. Murder and Race show the first
// frame of their loops (rendered by the games themselves, at their native size), so the
// still, the loop's poster and the loop line up: Murder's night harbour with its quay
// lantern on the spine, Race's pack in the park S-bend on Harbour Street, its spine a
// slice through the pack. Phones get a crop of the same frame made for the phone tile
// (`phone`, in which the cars stay large). Each `sizes` is the width the art is drawn at:
// open, the panel's width (at most 935 px; Race's art 1.4 times that, see the stage CSS)
// or its height (540-760 px) times the art's aspect, whichever is more; tablet tiles are
// 58vw tall, at most 420 px.
const PHONE = '(max-width: 559.98px)';
const ART = {
  robot: {
    src: robotKeyArt, widths: [1100, 1600, 2400, 3200, 3840], sizes: '(min-width: 960px) clamp(1820px, calc((100vh - 340px) * 3.9), 2950px), (min-width: 724px) 1960px, 270vw',
    x0: '50%', x1: '50%', y0: '50%', y1: '50%', xm: '30%', ym: '50%',
    // The part of the panorama a phone tile shows (the green robot and the unicorn), so
    // a phone fetches that and not the whole 3840 px panorama.
    phone: { src: robotKeyArtPhone, widths: [600, 900, 1170], sizes: '100vw', media: PHONE },
  },
  murder: {
    src: murderNight, widths: [640, 960, 1280, 1672],
    sizes: '(min-width: 960px) max(min(935px, 70vw), calc(clamp(540px, 100vh - 360px, 760px) * 1.78)), max(100vw, calc(clamp(220px, 58vw, 420px) * 1.78))',
    x0: '0%', x1: '0%', y0: '50%', y1: '50%', xm: '30%', ym: '50%',
    phone: { src: murderNightPhone, widths: [600, 900, 1170], sizes: '100vw', media: PHONE },
  },
  race: {
    src: raceNight, widths: [800, 1200, 1600, 2000, 2560],
    sizes: '(min-width: 960px) max(min(1310px, 97vw), calc(clamp(540px, 100vh - 360px, 760px) * 1.6)), max(100vw, calc(clamp(220px, 58vw, 420px) * 1.6))',
    x0: '54%', x1: '50%', y0: '50%', y1: '50%', xm: '50%', ym: '0%',
    phone: { src: raceNightPhone, widths: [600, 900, 1170], sizes: '100vw', media: PHONE },
  },
} as const;
// Each panel's loop (site.ts LOOPS): today's and any later one. The script takes the first
// whose end is still ahead when it makes the panel's video, so a page loaded after a loop's
// end (the build before the next one, or a cached copy) already plays the next.
const loopsOf = (slug: string) =>
  loopsFor(slug).map((l) => ({
    until: l.until?.toISOString(),
    position: l.position,
    aspect: +(1600 / l.height).toFixed(4),
    minWidth: l.minWidth,
    stillIsPoster: l.stillIsPoster,
    files: [720, 1200, 1600].map((w) => ({ w, webm: `/video/${l.name}-${w}.webm`, mp4: `/video/${l.name}-${w}.mp4` })),
  }));
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// A game's one fact as it reads at a glance: the number and its unit together, never apart.
const fact = (g: (typeof GAMES)[number]) => `${g.stat.value} ${g.stat.unit[lang]}`;

// ---- The studio band's facts, with the game numbers taken from games.ts.
const facts = [
  { n: SITE.founded, text: sv ? 'Grundad i Eskilstuna' : 'Founded in Eskilstuna' },
  { n: String(GAMES.length), text: sv ? 'Spel, vart och ett kring en idé' : 'Games, each built around one idea' },
  { n: ROBOT.stat.value, text: cap(ROBOT.stat.label[lang]), game: ROBOT.name },
  { n: MURDER.stat.value, text: cap(MURDER.stat.label[lang]), game: MURDER.name },
  { n: '0', text: sv ? 'Reklam eller prenumerationer, i något av spelen' : 'Ads or subscriptions, in any of the games' },
];
---
<Base title={title} description={description} lang={lang} path="/" bilingual image="/og/studio.jpg" imageAlt="The Perfect Robot, The Perfect Murder and The Perfect Race" jsonld={[website]}>
  <script is:inline slot="head">document.documentElement.classList.add('js')</script>

  <section class:list={['mast', { 'has-launch': launch }]}>
    <div class="wrap mast-in">
      <div class="mast-head">
        <p class="label">{sv ? 'Spelstudio i Eskilstuna sedan 2013' : 'Game studio in Eskilstuna, Sweden, since 2013'}</p>
        <h1>{sv ? 'Spel från UX Productions' : 'Games by UX Productions'}</h1>
        <p class="promise">{sv ? 'Ingen reklam, inga prenumerationer.' : 'No ads, no subscriptions.'}</p>
      </div>
      {launch && (
        <div class:list={['launch theme-robot', { 'has-cd': !steamOut }]}>
          <p class="launch-top">
            <span class="badge" data-after={launch.after?.chip}>{launch.chip}</span>
            <a class="launch-name" href={localize(`/games/${ROBOT.slug}/`, lang)}><GameTitle game={ROBOT} logoSizes="120px" eager /></a>
          </p>
          {/* Before the release the note keeps room for the longer of its two texts (the
              hidden ones in data-now and data-out), so the switch never moves the stage. */}
          <p class="launch-note" data-now={launch.after && launch.note} data-out={launch.after?.note}><span class="sents" data-after={launch.after?.note}><Words text={launch.note} sentences /></span></p>
          <div class="launch-row">
            <a class="btn primary" href={steam.url} rel="noopener">
              <Icon name="steam" />
              <span data-after={steamOut ? undefined : storeLabel('steam', lang, true)}>{storeLabel('steam', lang)}</span><span class="visually-hidden">{` (${ROBOT.name})`}</span>
            </a>
            {!steamOut && (
              <p class="cd" role="timer" data-countdown={ROBOT_STEAM_RELEASE.toISOString()} data-lang={lang} hidden>
                <span class="visually-hidden" data-cd-text></span>
                {units.map((u, i) => (
                  <span class="cd-card" aria-hidden="true"><b data-cd={i}>00</b><span>{u}</span></span>
                ))}
              </p>
            )}
          </div>
        </div>
      )}
      <p class="lede">{sv ? 'Tre spel som vart och ett bygger på en idé, för Steam, mobilen och webbläsaren.' : 'Three games, each built around one idea, for Steam, phones and the browser.'}</p>
      <nav class="jump" aria-label={sv ? 'Spelen' : 'The games'}>
        <ol>
          {GAMES.map((g) => (
            <li class={`theme-${g.theme}`}><a href={`#${g.slug}`}><GameIcon game={g} />{g.name}</a></li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  <section class="stage" aria-label={s.ourGames}>
    <div class="wrap">
      <div class="tri" data-tri>
        {GAMES.map((g) => {
          const href = localize(`/games/${g.slug}/`, lang);
          // The Robot's launch already has its own block in the masthead.
          const badge = g.slug === ROBOT.slug && launch ? undefined : badgeFor(g.slug);
          const art = ART[g.theme];
          const lead = g.slug === FEATURED_GAME;
          const main = g.stores[0];
          const loops = loopsOf(g.slug);
          return (
            <article
              id={g.slug}
              class:list={['tp game', `theme-${g.theme}`, { 'is-open': lead, 'has-phone-art': art.phone }]}
              aria-labelledby={`${g.slug}-t`}
              data-loops={loops.length ? JSON.stringify(loops) : undefined}
              data-pause={sv ? 'Pausa filmen' : 'Pause the video'}
              data-play={sv ? 'Spela filmen' : 'Play the video'}
              style={`--x0:${art.x0};--x1:${art.x1};--y0:${art.y0};--y1:${art.y1};--xm:${art.xm};--ym:${art.ym}`}
            >
              <div class="tp-art">
                <PanelArt src={art.src} widths={[...art.widths]} sizes={art.sizes} phone={art.phone && { ...art.phone, widths: [...art.phone.widths] }} eager={lead} />
              </div>
              {/* Phones: the game's app icon and its one fact on its art, like a box front. */}
              <div class="tp-cover" aria-hidden="true">
                <GameIcon game={g} class="tp-cover-icon" />
                <span class="tp-cover-stat"><b>{fact(g)}</b><Words text={g.stat.detail[lang]} /></span>
              </div>

              <div class="tp-body" id={`${g.slug}-body`}>
                {badge && <p class="tp-meta"><span class="badge">{badge[lang]}</span></p>}
                <p class="label accent"><GameIcon game={g} class="tp-icon-open" eager={lead} />{g.genre[lang]}</p>
                {/* The phone cover shows the game's fact only to the eye; where the pitch
                    does not already say it, screen readers get it here. */}
                {!g.pitch[lang].includes(g.stat.value) && !g.pitch[lang].includes(g.stat.label[lang]) && <p class="visually-hidden">{`${g.stat.value} ${g.stat.label[lang]}`}</p>}
                <h2 class="tp-title" id={`${g.slug}-t`}>
                  <a href={href}><GameTitle game={g} logoSizes="(min-width: 960px) clamp(230px, 21vw, 320px), 230px" /></a>
                </h2>
                <p class="tp-tag"><Words text={g.tagline[lang]} sentences /></p>
                <p class="tp-pitch"><Words text={g.pitch[lang]} /></p>
                <div class="tp-actions">
                  <StoreButtons game={g} lang={lang} mainOnly named />
                  <a class="more" href={href}>{s.aboutGame}<span class="visually-hidden">{` (${g.name})`}</span></a>
                </div>
                <ul class="chips" aria-label={sv ? 'Plattformar' : 'Platforms'}>{g.platforms.map((pl) => <li><span>{platformLabel(pl, lang)}</span></li>)}</ul>
              </div>

              {/* What a closed panel shows on wide screens, like the spine of a boxed edition:
                  the game's app icon, its own name turned on its side, what it is, one fact,
                  its button, and "More", which opens the panel (a click or tap anywhere on
                  the spine does the same). Only one of body and spine is visible at a time,
                  and only the visible one is in the accessibility tree and the tab order. */}
              <div class="tp-spine">
                <div class="tp-spine-top" aria-hidden="true">
                  <GameIcon game={g} class="tp-icon" />
                  <Mark variant="ux" class="tp-glyph" />
                </div>
                <h2 class="tp-vname"><GameTitle game={g} logoSizes="300px" /></h2>
                <div class="tp-foot">
                  <p class="tp-genre">{g.genreShort[lang]}</p>
                  <p class="tp-fact"><b>{fact(g)}</b> <span class="tp-detail"><Words text={g.stat.detail[lang]} /></span></p>
                  {/* On laptops the button shows only its first word (Play, Wishlist); the
                      whole label stays its name for screen readers. */}
                  <a class="btn primary tp-cta" href={main.url} rel="noopener">
                    <Icon name={main.kind} />
                    <span class="tp-cta-full" data-after={main.kind === 'steam' && !steamOut ? storeLabel('steam', lang, true) : undefined}>{storeLabel(main.kind, lang)}</span>
                    <span class="tp-cta-short" aria-hidden="true" data-after={main.kind === 'steam' && !steamOut ? storeShort('steam', lang, true) : undefined}>{storeShort(main.kind, lang)}</span>
                    <span class="visually-hidden">{` (${g.name})`}</span>
                  </a>
                  <a class="tp-more" href={`#${g.slug}`} aria-controls={`${g.slug}-body`}>
                    {sv ? 'Mer' : 'More'}<span class="visually-hidden">{sv ? ` om ${g.name}` : ` about ${g.name}`}</span>
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="news-strip" aria-labelledby="news-h">
      <div class="wrap ns-in">
        <div class="ns-head">
          <h2 id="news-h">{s.latestNews}</h2>
          <a href="/news/">{s.allNews}</a>
        </div>
        <ol class="ns-list">
          {news.map((p) => (
            <li>
              <a class="ns-item" href={`/news/${p.id}/`} hreflang="en">
                <Picture src={p.data.image} alt="" widths={[240, 480]} sizes="(max-width: 600px) 104px, 200px" formats={['avif', 'webp']} />
                <div class="ns-text">
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time>
                  <h3 lang="en">{p.data.title}</h3>
                  <p class="ns-desc" lang="en"><Words text={excerpt(p.data.description)} /></p>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="studio-band" aria-labelledby="studio-h">
    <div class="wrap sb-in">
      <Mark variant="logo" class="sb-mark" />
      <div class="sb-copy">
        <p class="label">{sv ? 'Sedan 2013 · Eskilstuna, Mälardalen' : 'Since 2013 · Eskilstuna, Mälardalen'}</p>
        <h2 id="studio-h">{sv ? 'En liten studio i Eskilstuna' : 'A small studio in Eskilstuna'}</h2>
        <p>
          <Words text={sv
            ? 'UX Productions har gjort spel och lärappar sedan 2013, i Mälardalen. I dag gör vi Perfect-spelen: tre spel som var och ett gör en sak så bra vi kan få till den, utan reklam och utan prenumerationer.'
            : 'UX Productions has made games and learning apps in Sweden’s Mälardalen region since 2013. Today we make the Perfect games: three games that each do one thing as well as we can make it, with no ads and no subscriptions.'} />
        </p>
        <p>
          {sv ? 'Vi gör också ' : 'We also make '}
          <a href={localize('/tools/', lang)}>{sv ? 'verktyg för Unity-utvecklare' : 'tools for Unity developers'}</a>
          {sv ? ' och ' : ' and '}
          <a href={localize('/games/other-work/', lang)}>{sv ? 'lärappar för svenska skolor' : 'learning apps for Swedish schools'}</a>.
        </p>
        <p class="sb-more"><a href={localize('/about/', lang)}>{sv ? 'Mer om studion' : 'More about the studio'}</a></p>
      </div>
      <div class="sb-side">
        <h3 class="visually-hidden">{sv ? 'Studion i siffror' : 'The studio in numbers'}</h3>
        <ul class="sb-facts">
          {facts.map((f) => (
            <li><b>{f.n}</b><span>{f.text}{f.game && <small>{f.game}</small>}</span></li>
          ))}
        </ul>
        <div class="sb-follow">
          <h3>{s.follow}</h3>
          <p>{s.followText}</p>
          <Socials variant="icons" />
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Progressive enhancement, all of it optional: the page is complete without it.
  //  1. On wide screens one panel is open and the others are spines. A spine opens only
  //     when it is clicked or tapped (or its "More" button pressed); pointing at it or
  //     tabbing through it only lights it up, so nothing moves under the pointer.
  //  2. A muted loop of the game (never with reduced motion or Save-Data), with a pause
  //     button. On wide screens, in the open panel: each panel's video is made the first
  //     time the panel opens (the Robot's, open from the start, once the page has loaded).
  //     On phones and tablets, in each tile while it is on screen (a small file); so a loop
  //     is downloaded only when someone opens or scrolls to its game.
  //  3. The launch countdown, and the switch to "out now" wording at the release.
  const wide = matchMedia('(min-width: 960px)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const tri = document.querySelector<HTMLElement>('[data-tri]');

  if (tri) {
    const panels = [...tri.querySelectorAll<HTMLElement>('.tp')];
    const videos = new Map<HTMLElement, HTMLVideoElement>();
    // Panels whose loop could not be played (a network error, a codec the browser lacks):
    // they keep their still, and are not tried again.
    const failed = new Set<HTMLElement>();
    let pauseButtons: HTMLButtonElement[] = [];
    // One pause for every loop: someone who stopped the motion does not get it back by
    // opening another game.
    let paused = false;
    let seen = true;
    let loaded = document.readyState === 'complete';
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

    // Phones and tablets: the tiles at least half on screen.
    const onScreen = new Set<HTMLElement>();
    const sync = () => {
      for (const [p, v] of videos) {
        const show = wide.matches ? p.classList.contains('is-open') && seen : onScreen.has(p);
        if (show && !paused && !still.matches) v.play().catch(() => {});
        else v.pause();
      }
    };

    type Loop = { until?: string; position: string; aspect: number; minWidth?: number; stillIsPoster?: boolean; files: { w: number; webm: string; mp4: string }[] };
    // A panel's loop for today: the first whose end is still ahead, if the open panel is
    // the size it is made for (`box` is the size of an open panel).
    const loopFor = (p: HTMLElement, box: DOMRect) => {
      const loop = (JSON.parse(p.dataset.loops!) as Loop[]).find((l) => !l.until || Date.now() < Date.parse(l.until));
      return loop && (!wide.matches || !loop.minWidth || (box.width >= loop.minWidth && box.width > box.height * 1.2)) ? loop : undefined;
    };

    // `box` is the size of an open panel, measured before this one starts to widen.
    const addVideo = (p: HTMLElement, box: DOMRect) => {
      if (videos.has(p) || failed.has(p) || !p.dataset.loops || !loaded || still.matches || saveData) return;
      const loop = loopFor(p, box);
      if (!loop) return;
      addButton(p);
      // While the loops are paused, a newly opened game gets its button (set to Play) but
      // no video yet: nothing is downloaded until the visitor presses Play.
      if (paused) {
        p.classList.add('has-loop');
        return;
      }
      // The loop covers the open panel (Race's at --art-zoom times its width). Take the
      // smaller file when it is never enlarged (at this screen's density), else the larger:
      // the games' fine detail (Race's pixel-art cars, Murder's windows) stays sharp.
      const zoom = parseFloat(getComputedStyle(p).getPropertyValue('--art-zoom')) || 1;
      // Phones take the small file: a moving picture there reads well below its pixel size.
      const art = wide.matches ? box : p.querySelector('.tp-art')!.getBoundingClientRect();
      const shown = wide.matches ? Math.max(art.width * zoom, art.height * loop.aspect) * devicePixelRatio : art.width * 1.6;
      const file = loop.files.find((f) => shown <= f.w) ?? loop.files[loop.files.length - 1];
      const v = document.createElement('video');
      videos.set(p, v);
      v.muted = true;
      v.loop = true;
      v.playsInline = true;
      v.preload = 'auto';
      v.className = 'tp-video';
      // Murder's and Race's still is the loop's first frame, already loaded: their poster.
      // The video is hidden until it plays, so the Robot's needs none.
      if (loop.stillIsPoster) v.poster = p.querySelector<HTMLImageElement>('.tp-art img')?.currentSrc ?? '';
      v.style.objectPosition = loop.position;
      // Moving art, not content: out of the accessibility tree and the tab order (Firefox
      // would stop on a video element), with no picture-in-picture or casting offered.
      v.setAttribute('aria-hidden', 'true');
      v.tabIndex = -1;
      v.disablePictureInPicture = true;
      v.setAttribute('disableremoteplayback', '');
      for (const [src, type] of [[file.webm, 'video/webm'], [file.mp4, 'video/mp4']]) {
        const so = document.createElement('source');
        so.src = src;
        so.type = type;
        v.append(so);
      }
      // The pause button shows once the loop can play; if neither file can, the panel
      // keeps its still and loses the button, so nothing offers to pause a video that
      // is not there.
      v.addEventListener('loadeddata', () => p.classList.add('has-loop'), { once: true });
      v.addEventListener('playing', () => p.classList.add('has-video'), { once: true });
      v.querySelector('source:last-child')!.addEventListener('error', () => drop(p), { once: true });
      // In a box of its own: the Robot's ends where its key art does (see .tp-loop).
      const frame = document.createElement('div');
      frame.className = 'tp-loop';
      frame.append(v);
      p.querySelector('.tp-art')!.append(frame);
    };
    // A loop that cannot play: its video and its button go, the still stays.
    const drop = (p: HTMLElement) => {
      failed.add(p);
      videos.get(p)?.closest('.tp-loop')?.remove();
      videos.delete(p);
      const pb = p.querySelector<HTMLButtonElement>('.tp-pause');
      pauseButtons = pauseButtons.filter((b) => b !== pb);
      pb?.remove();
      p.classList.remove('has-loop', 'has-video');
    };
    // The panel's pause button, made with its loop (or, while paused, in its place). It
    // shows (.has-loop) once the loop has its first frame, or at once while paused.
    const addButton = (p: HTMLElement) => {
      if (p.querySelector('.tp-pause')) return;
      const pb = document.createElement('button');
      pb.type = 'button';
      pb.className = 'tp-pause';
      pb.addEventListener('click', () => {
        paused = !paused;
        for (const b of pauseButtons) label(b);
        if (!paused) videoForOpen();
        else sync();
      });
      p.append(pb);
      pauseButtons.push(pb);
      label(pb);
    };
    const label = (b: HTMLButtonElement) => {
      const p = b.closest<HTMLElement>('.tp')!;
      b.classList.toggle('is-paused', paused);
      b.setAttribute('aria-label', paused ? p.dataset.play! : p.dataset.pause!);
    };
    const current = () => panels.find((q) => q.classList.contains('is-open'));
    const videoForOpen = () => {
      if (wide.matches) {
        const p = current();
        if (p) addVideo(p, p.getBoundingClientRect());
      } else for (const p of onScreen) addVideo(p, p.getBoundingClientRect());
      sync();
    };
    // Phones and tablets: a tile's loop is made when it first comes into view, and plays
    // only while it is there.
    const tiles = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const p = e.target as HTMLElement;
          if (e.isIntersecting) onScreen.add(p);
          else onScreen.delete(p);
          if (e.isIntersecting && !wide.matches) addVideo(p, p.getBoundingClientRect());
        }
        sync();
      },
      { threshold: 0.5 },
    );
    for (const p of panels) tiles.observe(p);

    // Transitions run only around a visitor's own gesture (and while pointing at or
    // tabbing through the stage), so loading, resizing or a screenshot never catches a
    // panel mid-move.
    let settle = 0;
    const open = (p: HTMLElement, how: 'pointer' | 'key' | 'hash') => {
      if (p.classList.contains('is-open')) return;
      const box = (current() ?? p).getBoundingClientRect();
      tri.classList.add('anim');
      tri.classList.toggle('kbd', how === 'key');
      clearTimeout(settle);
      settle = window.setTimeout(() => tri.classList.remove('anim'), 1200);
      for (const q of panels) q.classList.toggle('is-open', q === p);
      if (how !== 'hash' && wide.matches && !still.matches) {
        p.classList.remove('opening');
        void p.offsetWidth;
        p.classList.add('opening');
      }
      addVideo(p, box);
      sync();
    };

    for (const p of panels) {
      p.addEventListener('animationend', () => p.classList.remove('opening'));
      // "More" becomes a button that opens its panel; its hit area is the whole spine,
      // under the spine's own links (its store button), which still go where they say.
      const more = p.querySelector<HTMLAnchorElement>('a.tp-more');
      if (!more) continue;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = more.className;
      btn.innerHTML = more.innerHTML;
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-controls', more.getAttribute('aria-controls')!);
      more.replaceWith(btn);
      btn.addEventListener('click', (e) => {
        if (!wide.matches) return;
        const key = e.detail === 0;
        open(p, key ? 'key' : 'pointer');
        // The spine (and this button) are hidden now: carry focus to the opened panel. From
        // the keyboard, a title above or below the screen (reached by Shift+Tab from further
        // down) is brought into view with its panel, so what has focus is always seen.
        const title = p.querySelector<HTMLElement>('.tp-title a');
        title?.focus({ preventScroll: true });
        const r = title?.getBoundingClientRect();
        if (key && r && (r.top < 0 || r.bottom > innerHeight)) p.scrollIntoView({ block: 'nearest', behavior: still.matches ? 'auto' : 'smooth' });
      });
    }

    // A link to a game's panel (#the-perfect-race, as the phone jump chips make) opens
    // that panel, as it does without the script through :target.
    const fromHash = () => {
      const p = panels.find((q) => location.hash === `#${q.id}`);
      if (p && wide.matches) open(p, 'hash');
    };
    fromHash();
    addEventListener('hashchange', fromHash);

    // The loops play only while the stage is on screen, and stop when the window narrows
    // below 960 px or the visitor asks for reduced motion.
    new IntersectionObserver(([e]) => {
      seen = e.isIntersecting;
      sync();
    }).observe(tri);
    wide.addEventListener('change', videoForOpen);
    still.addEventListener('change', videoForOpen);
    // The open panel's loop (the Robot's, unless a link opened another game) waits for the
    // page itself to finish loading.
    if (loaded) videoForOpen();
    else
      addEventListener(
        'load',
        () => {
          loaded = true;
          videoForOpen();
        },
        { once: true },
      );
  }

  // The countdown: whole minutes left, as three move cards. At the release every
  // [data-after] text switches to its out-now wording, ahead of the next daily build.
  const cd = document.querySelector<HTMLElement>('[data-countdown]');
  if (cd) {
    const launch = Date.parse(cd.dataset.countdown!);
    const sv = cd.dataset.lang === 'sv';
    const cells = [...cd.querySelectorAll<HTMLElement>('[data-cd]')];
    const text = cd.querySelector<HTMLElement>('[data-cd-text]')!;
    const launched = () => {
      // Hidden, not removed: the cards keep their place, so nothing below moves.
      cd.hidden = true;
      text.textContent = '';
      for (const el of document.querySelectorAll<HTMLElement>('[data-after]')) {
        if (!el.dataset.after) continue;
        if (!el.classList.contains('sents')) {
          el.textContent = el.dataset.after;
          continue;
        }
        // A note set sentence by sentence (Words.astro) stays so.
        el.textContent = '';
        el.dataset.after.split(/(?<=[.!?]) +/).forEach((t, i) => {
          const sp = document.createElement('span');
          sp.className = 'sent';
          sp.textContent = t;
          el.append(...(i ? [' ', sp] : [sp]));
        });
      }
    };
    const tick = () => {
      const left = launch - Date.now();
      if (left <= 0) return launched();
      const mins = Math.ceil(left / 6e4);
      const parts = [Math.floor(mins / 1440), Math.floor(mins / 60) % 24, mins % 60];
      parts.forEach((n, i) => (cells[i].textContent = String(n).padStart(2, '0')));
      const [d, h, m] = parts.map((n, i) => `${n} ${(sv ? [['dag', 'dagar'], ['timme', 'timmar'], ['minut', 'minuter']] : [['day', 'days'], ['hour', 'hours'], ['minute', 'minutes']])[i][n === 1 ? 0 : 1]}`);
      text.textContent = sv ? `${d}, ${h} och ${m} kvar till släppet` : `${d}, ${h} and ${m} to the release`;
      cd.hidden = false;
      setTimeout(tick, Math.min(left, 60_000 - (Date.now() % 60_000) + 50));
    };
    tick();
  }
</script>

<style is:global>
