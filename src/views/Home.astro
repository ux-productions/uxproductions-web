  /* With the open panel's loop (from the moment it is made, and while the loops are
     paused): a window narrowed (or a tablet turned) below 960 px hides the video, and its
     button goes with it; so does reduced motion (see the end of the stage). */
  @media (min-width: 960px) {
    .tp.has-loop.is-open .tp-pause { display: block; z-index: 4; }
  }
  .tp-pause::before { content: ''; position: absolute; inset: 0; margin: auto; width: 10px; height: 12px; border-inline: 3px solid currentColor; box-sizing: border-box; }
  .tp-pause.is-paused::before { width: 0; height: 0; border: 0; border-left: 11px solid currentColor; border-block: 7px solid transparent; margin-left: 15px; }
  .tp-pause:hover { border-color: var(--g-text); }

  /* Each game's rule along the top of its panel: Robot's five letter colours, Murder's
     gold double rule, Race's chequered strip. Opening a panel plays its own gesture. */
  .tp::after { content: ''; position: absolute; inset: 0 0 auto; z-index: 3; pointer-events: none; }
  .theme-robot::after { height: 4px; background: linear-gradient(90deg, #ff7f8e 0 20%, #ffc857 0 40%, #74de78 0 60%, #5ce1e6 0 80%, #b98cff 0); }
  .theme-murder::after { height: 6px; border-block: 1.5px solid var(--g-accent); }
  .theme-race::after { height: 8px; background: repeating-conic-gradient(#e9edf5 0 25%, #0a0d13 0 50%) 0 0 / 8px 8px; }
  @media (prefers-reduced-motion: no-preference) {
    .theme-robot.opening::after { animation: rule-steps .6s steps(5, jump-start) both; }
    .theme-murder.opening::after { animation: rule-centre .9s cubic-bezier(.6, 0, .2, 1) both; }
    .theme-race.opening::after { animation: rule-wipe .42s cubic-bezier(.3, 0, .1, 1) both; }
  }
  @keyframes rule-steps { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  @keyframes rule-centre { from { clip-path: inset(0 50%); } to { clip-path: inset(0); } }
  @keyframes rule-wipe { from { clip-path: inset(0 0 0 100%); } to { clip-path: inset(0); } }

  /* Wide screens: one open panel and two spines, all three as tall as the tallest copy
     needs (every body keeps its width and its height, open or not), never shorter than
     the stage. A spine opens on a click or tap only; pointing at it or tabbing to it lights
     it up (art, top rule and "More") without moving anything. Without the script, a
     spine's "More" link opens its panel through :target. */
  @media (min-width: 960px) {
    .tri { --stage-h: clamp(540px, calc(100svh - 360px), 760px); display: flex; gap: 8px; min-height: var(--stage-h); }
    .tp {
      display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr);
      flex: calc(1 + 3.4 * var(--open)) 1 0; min-width: 170px;
      transition: flex-grow calc(var(--k) * var(--dur)) var(--ease);
    }
    html:not(.js) :where(.tri:has(.tp:target) .tp) { --open: 0; --pe: none; --sv: visible; --bv: hidden; }
    html:not(.js) :where(.tri .tp:target) { --open: 1; --pe: auto; --sv: hidden; --bv: visible; }

    /* The Robot's key art is a wide panorama, always drawn to the panel's height, so it
       is placed by two of its own points rather than by object-position: point --a of
       the art (a share of its width) sits at --r across the panel. As a spine (0) the
       floating head (75% across the art) is centred, a little smaller and below the
       app icon; open (1) the art zooms in and the green robot (44% across) stands just
       right of the copy, never past the panel's edge. --half is half the robot's width. */
    .theme-robot {
      --t0: 60px; --h0: min(100%, 520px); --r0: 50%; --a0: 75%;
      --t1: -43%; --h1: 125%; --a1: 44.3%; --half: calc(var(--stage-h) * .195);
      --r1: max(70%, min(calc(clamp(380px, 34vw, 540px) - clamp(14px, 1.5vw, 22px) + var(--half)), calc(100% - var(--half))));
    }
    .theme-robot .tp-art img {
      inset: auto; width: auto; max-width: none;
      top: calc(var(--t0) + (var(--t1) - var(--t0)) * var(--open));
      height: calc(var(--h0) + (var(--h1) - var(--h0)) * var(--open));
      left: calc(var(--r0) + (var(--r1) - var(--r0)) * var(--open));
      transform: translateX(calc(-1 * (var(--a0) + (var(--a1) - var(--a0)) * var(--open))));
    }
    /* Race: the game's camera keeps the pack mid-frame, so the open panel draws its loop
       (and the still, the loop's first frame) at least --art-zoom times the panel's width
       and puts the frame's middle (--ra1) 70% across (--rl1): the pack races right of the
       copy, its cars larger. As a spine it is drawn to the panel's height with the frame's
       65% line (--ra0) in the middle (--rl0): the pack runs down the spine's left half and
       the game's name over the empty track beside it. The script reads --art-zoom to pick
       the loop's file. */
    .theme-race { --art-zoom: 1.4; --ra0: 65%; --rl0: 50%; --ra1: 50%; --rl1: 70%; }
    .theme-race .tp-art { container-type: size; }
    .theme-race .tp-art :is(img, video) {
      --h: calc(100cqh + (max(100cqw * var(--art-zoom) / 1.6, 100cqh) - 100cqh) * var(--open));
      inset: auto; width: auto; max-width: none; height: var(--h);
      /* Open, the frame sits a little lower (6.5% of its height, as far as it reaches past
         the panel): the pack's trailing car then runs beside the shorter tagline, never
         on the end of the game's name. */
      top: calc((100cqh - var(--h)) / 2 + min(var(--h) * .065, (var(--h) - 100cqh) / 2) * var(--open));
      left: calc(var(--rl0) + (var(--rl1) - var(--rl0)) * var(--open));
      transform: translateX(calc(-1 * (var(--ra0) + (var(--ra1) - var(--ra0)) * var(--open))));
    }

    .tp-body, .tp-spine { grid-area: 1 / 1; }
    /* The open panel's copy. A closed panel's copy is hidden (out of the tab order and the
       accessibility tree) once it has faded; its spine stands in for it. */
    .tp-body {
      align-self: end; z-index: 1;
      width: clamp(380px, 34vw, 540px); padding: clamp(28px, 3vw, 44px) clamp(28px, 3vw, 44px) clamp(28px, 2.8vw, 40px);
      visibility: var(--bv); pointer-events: var(--pe);
      transition: visibility 0s linear calc(var(--k) * (1 - var(--open)) * .2s);
    }
    /* Opening, the lines come in one after another while the panel widens; closing, they
       leave at once. */
    .tp-body > * {
      opacity: var(--open); transform: translateY(calc((1 - var(--open)) * 10px));
      transition:
        opacity calc(var(--k) * (.12s + var(--open) * .22s)) ease-out calc(var(--k) * var(--open) * (.12s + var(--i, 0) * .05s)),
        transform calc(var(--k) * (.12s + var(--open) * .36s)) var(--ease) calc(var(--k) * var(--open) * (.12s + var(--i, 0) * .05s));
    }
    .tp-body > :nth-child(2) { --i: 1; }
    .tp-body > :nth-child(3) { --i: 2; }
    .tp-body > :nth-child(4) { --i: 3; }
    .tp-body > :nth-child(5) { --i: 4; }
    .tp-body > :nth-child(6) { --i: 5; }
    .tp-body > :nth-child(n + 7) { --i: 6; }
    /* Opened from the keyboard: the copy is there at once, so focus never lands on a line
       that is still fading in. */
    .tri.kbd .tp-body > * { transition-duration: .16s !important; transition-delay: 0s !important; }

    .tp-spine {
      z-index: 2; display: flex; flex-direction: column; min-height: 0; padding: 20px 16px 18px;
      opacity: calc(1 - var(--open)); visibility: var(--sv);
      /* Out quickly as its panel opens; back in only once the closing copy has gone. */
      transition:
        opacity calc(var(--k) * (.14s + (1 - var(--open)) * .3s)) ease calc(var(--k) * (1 - var(--open)) * .34s),
        visibility 0s linear calc(var(--k) * var(--open) * .14s);
    }
    .tp-spine-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
    /* At the top, like a boxed edition's spine: the game's app icon, and the studio's UX. */
    .tp-icon { width: 48px; height: 48px; box-shadow: 0 0 0 1px rgba(255, 255, 255, .16), 0 2px 16px 4px color-mix(in srgb, var(--g-bg) 78%, transparent); }
    .tp-glyph { width: 30px; height: auto; color: var(--g-accent); margin-top: 4px; }
    /* The game's own name turned on its side, reading up the spine, as large as the room
       it has allows (cqh, cqw: shares of its own box), so a short stage or larger text
       shrinks it instead of cutting it off. */
    .tp-vname { flex: 1 1 0; min-height: 0; margin: 14px 0; position: relative; container-type: size; font-size: 16px; line-height: 1; }
    .tp-vname > .gt {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(-90deg); white-space: nowrap;
      filter: drop-shadow(0 1px 3px color-mix(in srgb, var(--g-bg) 90%, transparent)) drop-shadow(0 0 10px color-mix(in srgb, var(--g-bg) 70%, transparent));
    }
    /* A soft band of the game's ground right behind the name, so the art (Race's cars and
       their headlights, Murder's lamp post) never runs through the letters, at rest or
       when the spine lights up. */
    .tp-vname > :is(.gt-murder, .gt-race)::before {
      content: ''; position: absolute; z-index: -1; inset: -1.1em -1.6em;
      background: radial-gradient(closest-side, color-mix(in srgb, var(--g-bg) 42%, transparent), transparent);
    }
    /* Room for the reader's own text spacing too (letters +.12em, words +.16em): Murder's
       within its box; Race's (16.6em long, 18.2em spaced) partly in the margins around it,
       which it may run into (nothing is cut), so the lockup stays as large as it can. */
    .theme-murder .tp-vname > .gt { font-size: min(44px, 100cqh / 13.8, 70cqw); }
    .theme-race .tp-vname > .gt { font-size: min(30px, 100cqh / 17.2, 40cqw); }
    .theme-robot .tp-vname > .gt-robot { width: min(300px, 100cqh, 160cqw); max-width: none; }
    /* Stacked above the name's soft band (z-index works on a flex item without making it
       a containing block, so "More" still covers the whole panel). */
    .tp-foot { display: flex; flex-direction: column; align-items: stretch; gap: 10px; z-index: 1; }
    .tp-genre { margin: 0; font: 500 11px/1.35 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--g-accent); hyphens: manual; overflow-wrap: break-word; }
    /* The game's one fact as plain words: the number and its unit together, then a few more. */
    .tp-fact { margin: 0 0 2px; color: var(--g-dim); font-size: 13.5px; line-height: 1.35; min-height: calc(19px * 1.2 + 1px + 2 * 13.5px * 1.35); }
    .tp-fact b { display: block; font: 700 19px/1.2 var(--body); color: var(--g-text); margin-bottom: 1px; }
    .tp-cta { position: relative; z-index: 2; min-height: 44px; padding: 8px 12px; gap: 8px; font-size: 14px; line-height: 1.2; text-align: left; justify-content: flex-start; }
    .tp-cta svg { width: 18px; height: 18px; }
    .tp-cta-short { display: none; }
    /* "More" opens the panel; its hit area covers the whole spine, under the store button. */
    .tp-more { display: inline-flex; align-items: center; gap: 4px; align-self: flex-start; margin: 0; padding: 4px 0; border: 0; background: none; font: 600 14px/1 var(--body); color: var(--g-text) !important; text-decoration: none; cursor: pointer; transition: color .25s; }
    .tp-more svg { width: 14px; height: 14px; transition: transform .25s var(--ease); }
    .tp-more::after { content: ''; position: absolute; inset: 0; z-index: 1; cursor: pointer; }
    .tp-more:focus-visible { outline: none; }
    .tp-more:focus-visible::after { outline: 2px solid var(--g-accent); outline-offset: -5px; border-radius: 4px; }
    /* A closed panel answers the pointer or the keyboard without moving: its art brightens,
       its top rule lights up and "More" takes the game's colour. The shade over the art
       stays, so the spine's small type at its foot keeps its contrast; the art brightens
       where it shows, in the middle. */
    .tp::after { opacity: calc(.55 + .45 * var(--open)); transition: opacity .3s; }
    .tp:not(.is-open):is(:hover, :focus-within)::after { opacity: 1; }
    .tp:not(.is-open):is(:hover, :focus-within) .tp-art img { filter: brightness(1.24) saturate(1.08); }
    .tp:not(.is-open):is(:hover, :focus-within) .tp-more { color: var(--g-accent) !important; }
    .tp:not(.is-open):is(:hover, :focus-within) .tp-more svg { transform: translateX(3px); }
  }
  /* Laptops: a lower stage (see the masthead). */
  @media (min-width: 960px) and (max-height: 860px) {
    .tri { --stage-h: clamp(450px, calc(100svh - 280px), 760px); }
  }
  /* Short stages (laptops, and any screen up to 960 px tall): the spine's foot gets
     compact, so the game's name, the spine's main line, has the room: the button shows
     only its first word (its whole label stays its name for screen readers), the fact
     keeps its number and unit, and Murder's name takes two lines ("The Perfect" /
     "Murder"); Race's lockup stays one line, as the game sets it. */
  @media (min-width: 960px) and (max-height: 960px) {
    .tp-spine { padding-top: 14px; }
    .tp-vname { margin: 8px 0 10px; }
    .tp-foot { gap: 8px; }
    .tp-detail { display: none; }
    .tp-fact { min-height: 0; }
    .tp-cta-full { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .tp-cta-short { display: inline; }
    .theme-murder .tp-vname > .gt-murder { font-size: min(44px, 100cqh / 9.4, 100cqw / 3.2); }
    .theme-murder .tp-vname > .gt-murder .gt-name { white-space: normal; width: min-content; }
  }
  /* Portrait tablets and tall narrow windows: the open panel is taller than it is wide
     and too narrow for the robot beside the copy, so the robot stands above it instead,
     in the panel's empty top half, unzoomed and right of centre. */
  @media (min-width: 960px) and (max-aspect-ratio: 1/1) {
    .theme-robot { --t1: -49%; --h1: 100%; --r1: 62%; }
  }

  /* Phones and tablets: a stack of art tiles, each with its button in view. */
  @media (max-width: 959.98px) {
    .stage { padding-top: 6px; }
    .tri { display: grid; gap: 0; margin-inline: calc(-1 * var(--gutter)); }
    .tp { --open: 1; --pe: auto; --bv: visible; border-radius: 0; display: flex; flex-direction: column; }
    .tp + .tp { border-top: 1px solid var(--line); }
    .tp-art { position: relative; inset: auto; height: clamp(220px, 58vw, 420px); }
    .tp-art :is(img, video) { object-position: var(--xm) var(--ym); }
    /* The Robot's panorama is cropped in so the green robot stands clear above the copy. */
    .theme-robot .tp-art img { top: -55%; height: 150%; }
    /* Phones: each game shows a crop of its art made for this tile (the Robot's is that
       same part of its panorama, with the same fade at its foot). */
    @media (max-width: 559.98px) {
      .has-phone-art .tp-art img { object-position: 50% 50%; }
      .theme-robot.has-phone-art .tp-art img { top: 0; height: 100%;
        -webkit-mask-image: linear-gradient(180deg, #000 68%, transparent 95%); mask-image: linear-gradient(180deg, #000 68%, transparent 95%); }
    }
    .tp-art::before { opacity: 1; background: linear-gradient(180deg, color-mix(in srgb, var(--g-bg) 80%, transparent) 0, transparent 46%); }
    .tp-art::after { background: linear-gradient(0deg, var(--g-bg) 0%, color-mix(in srgb, var(--g-bg) 70%, transparent) 24%, transparent 56%); }
    .tp-cover { position: absolute; z-index: 2; inset: 16px var(--gutter) auto; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
    .tp-cover-icon { width: 52px; height: 52px; box-shadow: 0 0 0 1px rgba(255, 255, 255, .16), 0 6px 18px rgba(0, 0, 0, .5); }
    .tp-icon-open { display: none; }
    /* The stat sits on a soft shade of the game's ground, so it reads even where the
       art behind it is bright (the Robot's laser). */
    .tp-cover-stat { position: relative; isolation: isolate; max-width: 11.5em; text-align: right; color: var(--g-text); font-size: 13.5px; line-height: 1.3; text-shadow: 0 1px 8px var(--g-bg); }
    .tp-cover-stat::before { content: ''; position: absolute; z-index: -1; inset: -16px -18px; border-radius: 18px; background: color-mix(in srgb, var(--g-bg) 85%, transparent); filter: blur(8px); }
    .tp-cover-stat b { display: block; font: 700 19px/1.2 var(--body); color: var(--g-text); margin-bottom: 2px; }
    .tp-body { position: relative; margin-top: -64px; padding: 0 var(--gutter) 40px; z-index: 1; }
    .tp.has-video .tp-art video { opacity: 1; }
    .tp.has-video .tp-art img { opacity: 0; }
    .theme-robot .tp-loop { bottom: 0; }
    .theme-robot .tp-loop video { height: 100%; }
    .tp.has-loop .tp-pause { display: block; z-index: 4; top: 86px; right: var(--gutter); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tp, .tp *, .tp::after, .tp-art::before, .tp-art::after { transition: none !important; animation: none !important; }
    /* Also when it is turned on while a loop plays: the still comes back. */
    .tp-loop, .tp-pause { display: none !important; }
    .tp.has-video.is-open .tp-art img { opacity: 1; }
  }

  /* Print: the games' copy and buttons as plain text; the art, the spines and the
     on-screen controls stay on screen. */
  @media print {
    .tp-art, .tp-cover, .tp-pause, .tp-spine, .cd, .jump, .tp::after, .launch::before { display: none !important; }
    .tri { display: block; min-height: 0; margin: 0; }
    .tp { display: block; overflow: visible; border: 0; break-inside: avoid; }
    .tp + .tp { border-top: 1px solid #bbb; }
    .tp-body { position: static; width: auto; margin: 0; padding: 18px 0; visibility: visible !important; }
    .tp-body > * { opacity: 1 !important; transform: none !important; }
    .launch { background: none; border: 1px solid #bbb; }
  }

  /* ---------- News strip ---------- */
  .news-strip { padding-block: clamp(36px, 4.5vw, 60px); border-top: 1px solid var(--line); }
  .ns-in { display: grid; grid-template-columns: minmax(150px, 220px) minmax(0, 1fr); gap: 20px 48px; align-items: start; }
  .ns-head { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .ns-head h2 { font: 700 clamp(1.9rem, 2.8vw, 2.6rem)/.95 var(--studio); text-transform: uppercase; letter-spacing: .01em; }
  .ns-head a { font-size: 15px; }
  .ns-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 18px 36px; }
  .ns-item { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 18px; align-items: start; color: var(--text); text-decoration: none; }
  .ns-item img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 3px; }
  .ns-text { display: flex; flex-direction: column; gap: 6px; }
  .ns-item time { font: 500 12px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-muted); }
  .ns-item h3 { font-size: 1.12rem; line-height: 1.25; }
  .ns-desc { margin: 0; color: var(--text-dim); font-size: 14.5px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ns-item:hover h3 { color: var(--accent); }
  @media (max-width: 760px) {
    .ns-in { grid-template-columns: 1fr; }
    .ns-head { flex-direction: row; justify-content: space-between; align-items: baseline; }
  }
  @media (max-width: 600px) {
    .ns-list { gap: 22px; }
    .ns-item { grid-template-columns: 104px minmax(0, 1fr); gap: 14px; }
    .ns-item h3 { font-size: 1.02rem; }
    /* Three lines on a phone's narrow column, so the excerpt ends where it was cut. */
    .ns-desc { font-size: 14px; -webkit-line-clamp: 3; }
  }

  /* ---------- Studio band: the logo's own paper and ink ---------- */
  .studio-band { background: var(--paper); color: var(--ink); padding-block: clamp(56px, 7vw, 104px); }
  .sb-in { display: grid; grid-template-columns: minmax(180px, 320px) minmax(0, 1.2fr) minmax(280px, .95fr); gap: clamp(32px, 4.5vw, 72px); align-items: start; }
  .sb-mark { display: block; width: 100%; height: auto; color: var(--ink); }
  .sb-copy .label { color: var(--ink-dim); margin: 0 0 12px; }
  .sb-copy h2 { font: 700 clamp(2.1rem, 3.6vw, 3.4rem)/.95 var(--studio); text-transform: uppercase; letter-spacing: .005em; margin-bottom: 18px; color: var(--ink); }
  .sb-copy p { color: var(--ink-dim); max-width: 36em; }
  .sb-copy p:last-child { margin-bottom: 0; }
  .studio-band a { color: var(--ink); text-decoration-thickness: 1px; }
  .studio-band a:hover { color: var(--ink); text-decoration-thickness: 2px; }
  .studio-band :focus-visible { outline-color: var(--ink); }
  .sb-more a { font-weight: 600; }
  .sb-facts { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .sb-facts li { display: grid; grid-template-columns: 4.2rem minmax(0, 1fr); gap: 14px; align-items: baseline; padding: 9px 0; border-bottom: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); }
  .sb-facts b { font: 700 1.75rem/1 var(--studio); letter-spacing: .01em; color: var(--ink); white-space: nowrap; }
  .sb-facts span { color: var(--ink-dim); font-size: 15px; line-height: 1.35; }
  .sb-facts small { display: block; font: 500 10.5px/1.6 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-dim); }
  .sb-follow { margin-top: 26px; }
  .sb-follow h3 { font: 700 1.3rem/1 var(--studio); text-transform: uppercase; letter-spacing: .06em; color: var(--ink); }
  .sb-follow p { color: var(--ink-dim); margin: 8px 0 14px; font-size: 15px; }
  .sb-follow .social-icons a { width: 48px; height: 48px; }
  /* Tablets: the mark beside the copy, then the facts and the socials side by side
     across the whole band, so no column runs empty. */
  @media (max-width: 1100px) {
    .sb-in { grid-template-columns: minmax(160px, 240px) minmax(0, 1fr); }
    .sb-side { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px clamp(32px, 4.5vw, 72px); align-items: start; }
    .sb-follow { margin-top: 0; }
  }
  @media (max-width: 680px) {
    .sb-in { grid-template-columns: 1fr; gap: 28px; }
