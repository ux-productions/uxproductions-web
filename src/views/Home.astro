---
import '@fontsource/bodoni-moda/700.css';
import '@fontsource/press-start-2p/400.css';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import Socials from '../components/Socials.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { GAMES } from '../data/games';
import { SITE, badgeFor, localize, t, type Lang } from '../data/site';
import { freshNews } from '../data/news';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const sv = lang === 'sv';
const news = await freshNews();

const title = sv ? 'UX Productions: The Perfect Robot, Murder och Race' : 'UX Productions: The Perfect Robot, Murder and Race';
const description = sv
  ? 'UX Productions är en spelstudio i Eskilstuna. Vi gör The Perfect Robot, The Perfect Murder och The Perfect Race för Steam, mobilen och webbläsaren.'
  : 'UX Productions is a game studio in Eskilstuna, Sweden. We make The Perfect Robot, The Perfect Murder and The Perfect Race for Steam, phones and the browser.';

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: 'UX Productions',
  url: `${SITE.url}/`,
  inLanguage: ['en', 'sv'],
  publisher: { '@id': `${SITE.url}/#organization` },
};
---
<Base title={title} description={description} lang={lang} path="/" bilingual image="/og/studio.jpg" imageAlt="The Perfect Robot, The Perfect Murder and The Perfect Race" jsonld={[website]}>
  <section class="front">
    <div class="wrap">
      <div class="front-head">
        <p class="label accent">{sv ? 'Spelstudio i Eskilstuna sedan 2013' : 'Game studio in Eskilstuna, Sweden, since 2013'}</p>
        <h1>{sv ? 'Spel från UX Productions' : 'Games by UX Productions'}</h1>
        <p class="lede">{sv ? 'Tre spel som vart och ett bygger på en idé. Ingen reklam, inga prenumerationer.' : 'Three games, each built around one idea. No ads, no subscriptions.'}</p>
      </div>
      <div class="panels">
        {GAMES.map((g, i) => {
          const href = localize(`/games/${g.slug}/`, lang);
          const badge = badgeFor(g.slug);
          return (
            <article class={`game panel theme-${g.theme}`}>
              <a class="panel-art" href={href} tabindex="-1" aria-hidden="true">
                <Picture
                  src={g.card}
                  alt=""
                  widths={[400, 640, 960]}
                  sizes="(max-width: 900px) 100vw, 380px"
                  formats={['avif', 'webp']}
                  loading="eager"
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                />
              </a>
              <div class="panel-body">
                {badge && <span class="badge">{badge[lang]}</span>}
                <span class="label accent">{g.genre[lang]}</span>
                <h2 class="panel-title"><a href={href}>{g.name}</a></h2>
                <p>{g.pitch[lang]}</p>
                <div class="panel-foot">
                  <div class="panel-actions">
                    <StoreButtons game={g} lang={lang} mainOnly />
                    <a class="more" href={href}>{s.aboutGame}</a>
                  </div>
                  <div class="chips">{g.platforms.map((pl) => <span>{pl}</span>)}</div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>{s.latestNews}</h2>
          <a href="/news/">{s.allNews}</a>
        </div>
        <NewsList posts={news} lang={lang} />
      </div>
    </section>
  )}
  <section class="section">
    <div class="wrap studio">
      <div>
        <h2>{sv ? 'En liten studio i Eskilstuna' : 'A small studio in Eskilstuna'}</h2>
        <p style="margin-top:16px">
          {sv
            ? 'UX Productions har gjort spel och lärappar sedan 2013, i Mälardalen. I dag gör vi Perfect-spelen: tre spel som var och ett gör en sak så bra vi kan få till den, utan reklam och utan prenumerationer.'
            : 'UX Productions has made games and learning apps in Sweden’s Mälardalen region since 2013. Today we make the Perfect games: three games that each do one thing as well as we can make it, with no ads and no subscriptions.'}
        </p>
        <p>
          {sv ? 'Vi gör också ' : 'We also make '}
          <a href={localize('/tools/', lang)}>{sv ? 'verktyg för Unity-utvecklare' : 'tools for Unity developers'}</a>
          {sv ? ' och ' : ' and '}
          <a href={localize('/games/other-work/', lang)}>{sv ? 'lärappar för svenska skolor' : 'learning apps for Swedish schools'}</a>.
        </p>
        <p><a href={localize('/about/', lang)}>{sv ? 'Mer om studion' : 'More about the studio'}</a></p>
      </div>
      <div>
        <h3 style="margin-bottom:6px">{s.follow}</h3>
        <p>{s.followText}</p>
        <Socials />
      </div>
    </div>
  </section>
</Base>

<style>
  .front {
    padding-block: clamp(36px, 6vw, 72px) clamp(8px, 2vw, 24px);
    background: radial-gradient(ellipse 70% 55% at 50% 0%, rgba(242, 169, 59, .13), transparent 70%);
  }
  .front-head { max-width: 40em; margin-bottom: clamp(24px, 4vw, 40px); }
  .front-head .label { margin: 0 0 10px; }
  .front-head h1 { margin-bottom: 12px; }
  .lede { font-size: clamp(1.1rem, 2vw, 1.3rem); color: var(--text-dim); margin: 0; }

  .panels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 900px) { .panels { grid-template-columns: 1fr; max-width: 560px; } }
  .panel { display: flex; flex-direction: column; border: 1px solid var(--g-line); border-top: 3px solid var(--g-accent); border-radius: var(--radius); overflow: hidden; }
  .panel-art { position: relative; display: block; }
  .panel-art img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .badge { align-self: flex-start; background: var(--g-cta); color: var(--g-cta-ink); font: 600 11px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; padding: 7px 9px; border-radius: 3px; }
  .panel-body { display: flex; flex-direction: column; gap: 10px; padding: 20px 22px 22px; flex: 1; }
  .panel-title { font-family: var(--g-title); font-size: 1.75rem; line-height: 1.15; }
  .theme-race .panel-title { font-size: 1.05rem; line-height: 1.5; letter-spacing: 0; }
  .theme-murder .panel-title { letter-spacing: 0; }
  .panel-title a { color: var(--g-text) !important; text-decoration: none; }
  .panel-title a:hover { color: var(--g-accent) !important; }
  .panel-body p { color: var(--g-dim); margin: 0; }
  .panel-foot { margin-top: auto; padding-top: 10px; display: grid; gap: 14px; }
  .panel .chips { padding-top: 0; }
  .panel-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
  .more { font-size: 15px; font-weight: 600; }
  .panel .chips span { color: var(--g-dim); border-color: var(--g-line); }
</style>
