---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import GameTitle from '../components/GameTitle.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import Socials from '../components/Socials.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { GAMES, MURDER, ROBOT } from '../data/games';
import { BADGES, FEATURED_GAME, ROBOT_STEAM_RELEASE, SITE, badgeFor, formatDate, localize, robotLoops, robotOnSteam, steamRelease, storeLabel, t, type Lang } from '../data/site';
import { freshNews } from '../data/news';
import robotKeyArt from '../assets/robot/key-art.jpg';
import racePanel from '../assets/race/panel.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const sv = lang === 'sv';
const news = await freshNews();

const title = sv ? 'UX Productions: The Perfect Robot, Murder och Race' : 'UX Productions: The Perfect Robot, Murder and Race';
const description = sv
  ? 'UX Productions är en spelstudio i Eskilstuna. Vi gör The Perfect Robot, The Perfect Murder och The Perfect Race för Steam, mobilen och webbläsaren.'
  : 'UX Productions is a game studio in Eskilstuna, Sweden. We make The Perfect Robot, The Perfect Murder and The Perfect Race for Steam, phones and the browser.';

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: 'UX Productions',
  url: `${SITE.url}/`,
  inLanguage: ['en', 'sv'],
  publisher: { '@id': `${SITE.url}/#organization` },
};

// ---- The Steam launch block in the masthead, while The Perfect Robot has a badge.
// Static text first; the script adds the countdown and switches the words at release.
const launchBadge = badgeFor(ROBOT.slug);
const steamOut = robotOnSteam();
const release = steamRelease(lang);
const outBadge = BADGES.find((b) => b.game === ROBOT.slug && b.from?.getTime() === ROBOT_STEAM_RELEASE.getTime());
// The chip already says "out now", so the sentence says when it came out.
const outNote = sv
  ? `Släpptes på Steam ${release.day}. Finns också på iOS och Android.`
  : `Released on Steam on ${release.day}. Also on iOS and Android.`;
const launch = launchBadge && {
  // A no-break space before the dot: a narrow chip breaks after it, never inside the time.
  chip: steamOut ? launchBadge[lang] : `${launchBadge[lang]} · ${release.time}`,
  note: steamOut
    ? outNote
    : sv ? `Släpps på Steam ${release.day} ${release.time}. Finns redan på iOS och Android.` : `Comes to Steam on ${release.day} at ${release.time}. Already out on iOS and Android.`,
  // What the words become at the release, for a page that is open at that moment.
  after: steamOut ? undefined : { chip: outBadge?.[lang], note: outNote },
};
const steam = ROBOT.stores.find((st) => st.kind === 'steam')!;
const units = sv ? ['Dagar', 'Timmar', 'Min'] : ['Days', 'Hours', 'Min'];

// ---- The three panels. How each game's art sits on wide screens: x and y as a spine
// (x0, y0) and open (x1, y1); and on phones (xm, ym). The Robot places its key art by
// two of its own points instead (see the stage CSS): the floating head centred on its
// spine, and the green robot right of the copy when open. Race uses one crop of a night
// circuit from its press screenshot, large enough never to be upscaled: its spine runs
// along the circuit's straight, clear of the cars, and the open panel keeps the whole
// car pack in frame. Each `sizes` is the width the art is drawn at (the stage is
// 540-760 px tall; phone tiles 58vw, at most 420 px).
const ART = {
  robot: { src: robotKeyArt, widths: [1100, 1600, 2400, 3200, 3840], sizes: '(min-width: 960px) clamp(1820px, calc((100vh - 340px) * 3.9), 2950px), (min-width: 724px) 1960px, 270vw', x0: '50%', x1: '50%', y0: '50%', y1: '50%', xm: '30%', ym: '50%' },
  murder: { src: MURDER.hero, widths: [640, 840, 1200, 1672], sizes: '(min-width: 960px) max(960px, calc((100vh - 360px) * 1.78)), 105vw', x0: '34%', x1: '60%', y0: '50%', y1: '50%', xm: '40%', ym: '50%' },
  race: { src: racePanel, widths: [600, 1000, 1400, 1730], sizes: '(min-width: 960px) 1000px, 100vw', x0: '100%', x1: '50%', y0: '50%', y1: '60%', xm: '50%', ym: '45%' },
} as const;
// The Robot panel's loop (site.ts ROBOT_LOOPS): today's, and any later one, so a page
// left open past a loop's end switches by itself.
const loops = robotLoops().map((l) => ({
  until: l.until?.toISOString(),
  position: l.position,
  files: [1200, 1600].map((w) => ({ w, webm: `/video/robot-loop-${l.name}-${w}.webm`, mp4: `/video/robot-loop-${l.name}-${w}.mp4`, poster: `/video/robot-loop-${l.name}-${w}.jpg` })),
}));
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const pad = (i: number) => String(i + 1).padStart(2, '0');

// ---- The studio band's facts, with the game numbers taken from games.ts.
const facts = [
  { n: SITE.founded, text: sv ? 'Grundad i Eskilstuna' : 'Founded in Eskilstuna' },
  { n: String(GAMES.length), text: sv ? 'Spel, vart och ett kring en idé' : 'Games, each built around one idea' },
  { n: ROBOT.stat.value, text: cap(ROBOT.stat.label[lang]), game: ROBOT.name },
  { n: MURDER.stat.value, text: cap(MURDER.stat.label[lang]), game: MURDER.name },
  { n: '0', text: sv ? 'Reklam eller prenumerationer, i något av spelen' : 'Ads or subscriptions, in any of the games' },
];
---
<Base title={title} description={description} lang={lang} path="/" bilingual image="/og/studio.jpg" imageAlt="The Perfect Robot, The Perfect Murder and The Perfect Race" jsonld={[website]} fonts={['murder', 'race']}>
  <script is:inline slot="head">document.documentElement.classList.add('js')</script>

  <section class:list={['mast', { 'has-launch': launch }]}>
    <div class="wrap mast-in">
      <div class="mast-head">
        <p class="label">{sv ? 'Spelstudio i Eskilstuna sedan 2013' : 'Game studio in Eskilstuna, Sweden, since 2013'}</p>
        <h1>{sv ? 'Spel från UX Productions' : 'Games by UX Productions'}</h1>
        <p class="promise">{sv ? 'Ingen reklam, inga prenumerationer.' : 'No ads, no subscriptions.'}</p>
      </div>
      {launch && (
        <div class:list={['launch theme-robot', { 'has-cd': !steamOut }]}>
          <p class="launch-top">
            <span class="badge" data-after={launch.after?.chip}>{launch.chip}</span>
            <a class="launch-name" href={localize(`/games/${ROBOT.slug}/`, lang)}><GameTitle game={ROBOT} logoSizes="120px" eager /></a>
          </p>
          <p class="launch-note" data-after={launch.after?.note}>{launch.note}</p>
          <div class="launch-row">
            <a class="btn primary" href={steam.url} rel="noopener">
              <Icon name="steam" />
              <span data-after={steamOut ? undefined : storeLabel('steam', lang, true)}>{storeLabel('steam', lang)}</span><span class="visually-hidden">{` (${ROBOT.name})`}</span>
            </a>
            {!steamOut && (
              <p class="cd" role="timer" data-countdown={ROBOT_STEAM_RELEASE.toISOString()} data-lang={lang} hidden>
                <span class="visually-hidden" data-cd-text></span>
                {units.map((u, i) => (
                  <span class="cd-card" aria-hidden="true"><b data-cd={i}>00</b><span>{u}</span></span>
                ))}
              </p>
            )}
          </div>
        </div>
      )}
      <p class="lede">{sv ? 'Tre spel som vart och ett bygger på en idé, för Steam, mobilen och webbläsaren.' : 'Three games, each built around one idea, for Steam, phones and the browser.'}</p>
      <nav class="jump" aria-label={sv ? 'Spelen' : 'The games'}>
        <ol>
          {GAMES.map((g, i) => (
            <li class={`theme-${g.theme}`}><a href={`#${g.slug}`}><span aria-hidden="true">{pad(i)}</span>{g.name}</a></li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  <section class="stage" aria-label={s.ourGames}>
    <div class="wrap">
      <div class="tri" data-tri>
        {GAMES.map((g, i) => {
          const href = localize(`/games/${g.slug}/`, lang);
          // The Robot's launch already has its own block in the masthead.
          const badge = g.slug === ROBOT.slug && launch ? undefined : badgeFor(g.slug);
          const art = ART[g.theme];
          const lead = g.slug === FEATURED_GAME;
          const main = g.stores[0];
          return (
            <article
              id={g.slug}
              class:list={['tp game', `theme-${g.theme}`, { 'is-open': lead }]}
              aria-labelledby={`${g.slug}-t`}
              data-loops={g.theme === 'robot' && loops.length ? JSON.stringify(loops) : undefined}
              data-pause={sv ? 'Pausa filmen' : 'Pause the video'}
              data-play={sv ? 'Spela filmen' : 'Play the video'}
              style={`--x0:${art.x0};--x1:${art.x1};--y0:${art.y0};--y1:${art.y1};--xm:${art.xm};--ym:${art.ym}`}
            >
              <div class="tp-art">
                <Picture
                  src={art.src}
                  alt=""
                  widths={art.widths.filter((w) => w <= art.src.width)}
                  sizes={art.sizes}
                  formats={['avif', 'webp']}
                  loading={lead ? 'eager' : 'lazy'}
                  fetchpriority={lead ? 'high' : 'auto'}
                />
                {/* Phones: the number and the game's one fact on its art, like a box front. */}
                <div class="tp-cover" aria-hidden="true">
                  <span class="tp-num">{pad(i)}</span>
                  <span class="tp-cover-stat"><b>{g.stat.value}</b>{g.stat.label[lang]}</span>
                </div>
              </div>

              <div class="tp-body" id={`${g.slug}-body`}>
                {badge && <p class="tp-meta"><span class="badge">{badge[lang]}</span></p>}
                <p class="label accent"><span class="tp-idx">{pad(i)}</span>{g.genre[lang]}</p>
                {/* The spine and the phone cover show the game's number only to the eye;
                    where the pitch does not already say it, screen readers get it here. */}
                {!g.pitch[lang].includes(g.stat.value) && !g.pitch[lang].includes(g.stat.label[lang]) && <p class="visually-hidden">{`${g.stat.value} ${g.stat.label[lang]}`}</p>}
                <h2 class="tp-title" id={`${g.slug}-t`}>
                  <a href={href}><GameTitle game={g} logoSizes="(min-width: 960px) clamp(230px, 21vw, 320px), 320px" eager={lead} /></a>
                </h2>
                <p class="tp-tag">{g.tagline[lang]}</p>
                <p class="tp-pitch">{g.pitch[lang]}</p>
                <div class="tp-actions">
                  <StoreButtons game={g} lang={lang} mainOnly named />
                  <a class="more" href={href}>{s.aboutGame}<span class="visually-hidden">{` (${g.name})`}</span></a>
                </div>
                <ul class="chips" aria-label={sv ? 'Plattformar' : 'Platforms'}>{g.platforms.map((pl) => <li><span>{pl}</span></li>)}</ul>
              </div>

              {/* What a closed panel shows on wide screens, like the spine of a boxed edition:
                  its number, the game's own name turned on its side, what it is, one number,
                  its button, and "More", which opens the panel (a click or tap anywhere on
                  the spine does the same). Only one of body and spine is visible at a time,
                  and only the visible one is in the accessibility tree and the tab order. */}
              <div class="tp-spine">
                <div class="tp-spine-top" aria-hidden="true">
                  <span class="tp-no">{pad(i)}</span>
                  <Mark variant="ux" class="tp-glyph" />
                </div>
                <h2 class="tp-vname"><GameTitle game={g} logoSizes="300px" /></h2>
                <div class="tp-foot">
                  <p class="tp-genre">{g.genreShort[lang]}</p>
                  <p class="tp-fact"><b>{g.stat.value}</b> {g.stat.label[lang]}</p>
                  <a class="btn primary tp-cta" href={main.url} rel="noopener">
                    <Icon name={main.kind} />
                    <span data-after={main.kind === 'steam' && !steamOut ? storeLabel('steam', lang, true) : undefined}>{storeLabel(main.kind, lang)}</span><span class="visually-hidden">{` (${g.name})`}</span>
                  </a>
                  <a class="tp-more" href={`#${g.slug}`} aria-controls={`${g.slug}-body`}>
                    {sv ? 'Mer' : 'More'}<span class="visually-hidden">{sv ? ` om ${g.name}` : ` about ${g.name}`}</span>
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="news-strip" aria-labelledby="news-h">
      <div class="wrap ns-in">
        <div class="ns-head">
          <h2 id="news-h">{s.latestNews}</h2>
          <a href="/news/">{s.allNews}</a>
        </div>
        <ol class="ns-list">
          {news.map((p) => (
            <li>
              <a class="ns-item" href={`/news/${p.id}/`} hreflang="en">
                <Picture src={p.data.image} alt="" widths={[240, 480]} sizes="(max-width: 600px) 104px, 200px" formats={['avif', 'webp']} />
                <div class="ns-text">
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time>
                  <h3 lang="en">{p.data.title}</h3>
                  <p class="ns-desc" lang="en">{p.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="studio-band" aria-labelledby="studio-h">
    <div class="wrap sb-in">
      <Mark variant="logo" class="sb-mark" />
      <div class="sb-copy">
        <p class="label">{sv ? 'Sedan 2013 · Eskilstuna, Mälardalen' : 'Since 2013 · Eskilstuna, Mälardalen'}</p>
        <h2 id="studio-h">{sv ? 'En liten studio i Eskilstuna' : 'A small studio in Eskilstuna'}</h2>
        <p>
          {sv
            ? 'UX Productions har gjort spel och lärappar sedan 2013, i Mälardalen. I dag gör vi Perfect-spelen: tre spel som var och ett gör en sak så bra vi kan få till den, utan reklam och utan prenumerationer.'
            : 'UX Productions has made games and learning apps in Sweden’s Mälardalen region since 2013. Today we make the Perfect games: three games that each do one thing as well as we can make it, with no ads and no subscriptions.'}
        </p>
        <p>
          {sv ? 'Vi gör också ' : 'We also make '}
          <a href={localize('/tools/', lang)}>{sv ? 'verktyg för Unity-utvecklare' : 'tools for Unity developers'}</a>
          {sv ? ' och ' : ' and '}
          <a href={localize('/games/other-work/', lang)}>{sv ? 'lärappar för svenska skolor' : 'learning apps for Swedish schools'}</a>.
        </p>
        <p class="sb-more"><a href={localize('/about/', lang)}>{sv ? 'Mer om studion' : 'More about the studio'}</a></p>
      </div>
      <div class="sb-side">
        <h3 class="visually-hidden">{sv ? 'Studion i siffror' : 'The studio in numbers'}</h3>
        <ul class="sb-facts">
          {facts.map((f) => (
            <li><b>{f.n}</b><span>{f.text}{f.game && <small>{f.game}</small>}</span></li>
          ))}
        </ul>
        <div class="sb-follow">
          <h3>{s.follow}</h3>
          <p>{s.followText}</p>
          <Socials variant="icons" />
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Progressive enhancement, all of it optional: the page is complete without it.
  //  1. On wide screens one panel is open and the others are spines. A spine opens only
  //     when it is clicked or tapped (or its "More" button pressed); pointing at it or
  //     tabbing through it only lights it up, so nothing moves under the pointer.
  //  2. A muted loop of the game in the open Robot panel (wide screens, after load, never
  //     with reduced motion or Save-Data), with a pause button.
  //  3. The launch countdown, and the switch to "out now" wording at the release.
  const wide = matchMedia('(min-width: 960px)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const tri = document.querySelector<HTMLElement>('[data-tri]');

  if (tri) {
    const panels = [...tri.querySelectorAll<HTMLElement>('.tp')];
    let video: HTMLVideoElement | undefined;
    let paused = false;
    let seen = true;
    const vp = panels.find((p) => p.dataset.loops);

    const sync = () => {
      if (!video || !vp) return;
      if (vp.classList.contains('is-open') && seen && !paused && wide.matches && !still.matches) video.play().catch(() => {});
      else video.pause();
    };

    // Transitions run only around a visitor's own gesture (and while pointing at or
    // tabbing through the stage), so loading, resizing or a screenshot never catches a
    // panel mid-move.
    let settle = 0;
    const open = (p: HTMLElement, how: 'pointer' | 'key' | 'hash') => {
      if (p.classList.contains('is-open')) return;
      tri.classList.add('anim');
      tri.classList.toggle('kbd', how === 'key');
      clearTimeout(settle);
      settle = window.setTimeout(() => tri.classList.remove('anim'), 1200);
      for (const q of panels) q.classList.toggle('is-open', q === p);
      if (how !== 'hash' && wide.matches && !still.matches) {
        p.classList.remove('opening');
        void p.offsetWidth;
        p.classList.add('opening');
      }
      sync();
    };

    for (const p of panels) {
      p.addEventListener('animationend', () => p.classList.remove('opening'));
      // "More" becomes a button that opens its panel; its hit area is the whole spine,
      // under the spine's own links (its store button), which still go where they say.
      const more = p.querySelector<HTMLAnchorElement>('a.tp-more');
      if (!more) continue;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = more.className;
      btn.innerHTML = more.innerHTML;
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-controls', more.getAttribute('aria-controls')!);
      more.replaceWith(btn);
      btn.addEventListener('click', (e) => {
        if (!wide.matches) return;
        open(p, e.detail === 0 ? 'key' : 'pointer');
        // The spine (and this button) are hidden now: carry focus to the opened panel.
        p.querySelector<HTMLElement>('.tp-title a')?.focus({ preventScroll: true });
      });
    }

    // A link to a game's panel (#the-perfect-race, as the phone jump chips make) opens
    // that panel, as it does without the script through :target.
    const fromHash = () => {
      const p = panels.find((q) => location.hash === `#${q.id}`);
      if (p && wide.matches) open(p, 'hash');
    };
    fromHash();
    addEventListener('hashchange', fromHash);

    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (vp && wide.matches && !still.matches && !saveData) {
      type Loop = { until?: string; position: string; files: { w: number; webm: string; mp4: string; poster: string }[] };
      const loops: Loop[] = JSON.parse(vp.dataset.loops!);
      const start = () => {
        // Today's loop: the first whose end is still ahead.
        const loop = loops.find((l) => !l.until || Date.now() < Date.parse(l.until));
        if (!loop) return;
        // The loop covers the open panel. Take the smaller file when it is shown at no
        // more than 1.1 times its own pixels (at this screen's density), else the larger.
        const box = (tri.querySelector('.tp.is-open') ?? vp).getBoundingClientRect();
        const shown = Math.max(box.width, box.height * (1600 / 1024)) * devicePixelRatio;
        const file = loop.files.find((f) => shown <= f.w * 1.1) ?? loop.files[loop.files.length - 1];
        const v = (video = document.createElement('video'));
        v.muted = true;
        v.loop = true;
        v.playsInline = true;
        v.preload = 'auto';
        v.className = 'tp-video';
        v.poster = file.poster;
        v.style.objectPosition = loop.position;
        v.setAttribute('aria-hidden', 'true');
        for (const [src, type] of [[file.webm, 'video/webm'], [file.mp4, 'video/mp4']]) {
          const so = document.createElement('source');
          so.src = src;
          so.type = type;
          v.append(so);
        }
        v.addEventListener('playing', () => vp.classList.add('has-video'));
        vp.querySelector('.tp-art')!.append(v);

        const pb = document.createElement('button');
        pb.type = 'button';
        pb.className = 'tp-pause';
        pb.setAttribute('aria-label', vp.dataset.pause!);
        pb.addEventListener('click', () => {
          paused = !paused;
          pb.classList.toggle('is-paused', paused);
          pb.setAttribute('aria-label', paused ? vp.dataset.play! : vp.dataset.pause!);
          sync();
        });
        vp.append(pb);

        new IntersectionObserver(([e]) => {
          seen = e.isIntersecting;
          sync();
        }).observe(tri);
        wide.addEventListener('change', sync);
        still.addEventListener('change', sync);
        sync();
      };
      if (document.readyState === 'complete') start();
      else addEventListener('load', start, { once: true });
    }
  }

  // The countdown: whole minutes left, as three move cards. At the release every
  // [data-after] text switches to its out-now wording, ahead of the next daily build.
  const cd = document.querySelector<HTMLElement>('[data-countdown]');
  if (cd) {
    const launch = Date.parse(cd.dataset.countdown!);
    const sv = cd.dataset.lang === 'sv';
    const cells = [...cd.querySelectorAll<HTMLElement>('[data-cd]')];
    const text = cd.querySelector<HTMLElement>('[data-cd-text]')!;
    const launched = () => {
      // Hidden, not removed: the cards keep their place, so nothing below moves.
      cd.hidden = true;
      text.textContent = '';
      for (const el of document.querySelectorAll<HTMLElement>('[data-after]')) if (el.dataset.after) el.textContent = el.dataset.after;
    };
    const tick = () => {
      const left = launch - Date.now();
      if (left <= 0) return launched();
      const mins = Math.ceil(left / 6e4);
      const parts = [Math.floor(mins / 1440), Math.floor(mins / 60) % 24, mins % 60];
      parts.forEach((n, i) => (cells[i].textContent = String(n).padStart(2, '0')));
      const [d, h, m] = parts.map((n, i) => `${n} ${(sv ? [['dag', 'dagar'], ['timme', 'timmar'], ['minut', 'minuter']] : [['day', 'days'], ['hour', 'hours'], ['minute', 'minutes']])[i][n === 1 ? 0 : 1]}`);
      text.textContent = sv ? `${d}, ${h} och ${m} kvar till släppet` : `${d}, ${h} and ${m} to the release`;
      cd.hidden = false;
      setTimeout(tick, Math.min(left, 60_000 - (Date.now() % 60_000) + 50));
    };
    tick();
  }
</script>

<style is:global>
  /* ---------- Masthead: who we are, and the Steam launch while it is news ---------- */
  .mast { padding-block: clamp(26px, 3.4vw, 46px) clamp(18px, 2vw, 26px); }
  .mast-in { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px 48px; align-items: end; }
  .mast .label { margin: 0 0 12px; text-wrap: balance; }
  .mast h1 { font: 700 clamp(2.5rem, 4.6vw, 4.6rem)/.92 var(--studio); text-transform: uppercase; letter-spacing: .005em; }
  /* The studio's promise, said as plainly as the name above it. */
  .promise { margin: 14px 0 0; font: 700 clamp(1.45rem, 2.3vw, 2.25rem)/1 var(--studio); letter-spacing: .02em; text-transform: uppercase; color: var(--accent); text-wrap: balance; }
  .lede { max-width: 36em; margin: 0; color: var(--text-dim); font-size: clamp(1.05rem, 1.35vw, 1.22rem); line-height: 1.45; text-wrap: pretty; }
  @media (min-width: 960px) {
    /* Without a launch the lede sits on the h1's baseline, to its right. */
    .mast:not(.has-launch) .mast-in { grid-template-columns: auto minmax(0, 26em); justify-content: space-between; }
    .mast:not(.has-launch) .lede { padding-bottom: 6px; }
    .mast.has-launch .mast-in { grid-template: 'head launch' 1fr 'lede launch' auto / minmax(0, 1fr) minmax(400px, 540px); row-gap: 18px; }
    .mast.has-launch .mast-head { grid-area: head; align-self: end; }
    .mast.has-launch .lede { grid-area: lede; align-self: end; padding-bottom: 2px; }
    .launch { grid-area: launch; }
  }
  /* Laptops (1280x720, 1366x768): a tighter masthead and launch block, so the stage
     and all three panels' buttons fit on the first screen. */
  @media (min-width: 960px) and (max-height: 860px) {
    .mast { padding-block: 16px 14px; }
    .mast .label { margin-bottom: 8px; }
    .mast h1 { font-size: clamp(2.3rem, 3.9vw, 3.6rem); }
    .promise { margin-top: 10px; font-size: clamp(1.35rem, 2vw, 1.8rem); }
    .mast.has-launch .mast-in { row-gap: 12px; }
    .launch { padding: 14px 18px; }
    .launch-note { margin-top: 8px; font-size: 14.5px; line-height: 1.45; }
    .launch .btn { min-height: 42px; }
  }

  /* The launch: The Perfect Robot's own navy and its logo's letter colours. */
  .launch { --c1: #ff7f8e; --c2: #ffc857; --c3: #74de78; --c4: #5ce1e6; --c5: #b98cff;
    position: relative; padding: 20px 22px; border-radius: 6px; background: #0e1b2e; border: 1px solid #24476b; color: var(--g-text); }
  .launch::before { content: ''; position: absolute; top: -1px; left: -1px; right: -1px; height: 4px; border-radius: 6px 6px 0 0;
    background: linear-gradient(90deg, var(--c1) 0 20%, var(--c2) 0 40%, var(--c3) 0 60%, var(--c4) 0 80%, var(--c5) 0); }
  .launch-top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 0; }
  .badge { background: var(--g-cta); color: var(--g-cta-ink); font: 600 11.5px/1.2 var(--mono); letter-spacing: .08em; text-transform: uppercase; padding: 6px 9px; border-radius: 3px; }
  .launch-top .badge { margin-right: auto; }
  .launch-name { display: block; line-height: 0; border-radius: 3px; }
  .launch-name .gt-robot { width: 104px; margin: -10px -6px -12px 0; }
  .launch-name:hover .gt-robot { filter: brightness(1.1); }
  .launch-note { margin: 12px 0 0; color: var(--g-dim); font-size: 15.5px; line-height: 1.5; text-wrap: balance; }
  .launch-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 20px; margin-top: 16px; }
  .launch :focus-visible { outline-color: var(--c4); }
  /* The countdown as move cards: a coloured top with the number, the unit under it.
     It waits for the script with its space kept, so nothing moves when it appears.
     --cd-n and --cd-u are the number and unit sizes; a card is (n + u + 26px) tall. */
  .launch { --cd-n: 1.6rem; --cd-u: 10px; --cd-w: 58px; --cd-pad: 0px; }
  .cd { display: flex; gap: 8px; margin: 0; }
  html.js .cd[hidden] { display: flex !important; visibility: hidden; }
  .cd-card { display: block; width: var(--cd-w); border-radius: 6px; overflow: hidden; background: #0a1524; border: 1px solid #24476b; text-align: center; box-shadow: 0 3px 0 #050c16; }
  .cd-card b { display: block; background: var(--c); color: #0a1524; font: 700 var(--cd-n)/1 var(--studio); padding: calc(7px - var(--cd-pad)) 0 calc(5px - var(--cd-pad)); font-variant-numeric: tabular-nums;
    box-shadow: inset 0 -3px 0 rgba(10, 21, 36, .18), inset 0 2px 0 rgba(255, 255, 255, .35); }
  .cd-card span { display: block; font: 600 var(--cd-u)/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--c); padding: calc(6px - var(--cd-pad)) 0; }
  /* At the release the script hides the countdown but keeps its place, and the sentence
     keeps its two lines, so the stage below never jumps. */
  @media (min-width: 960px) {
    html.js .launch.has-cd .launch-note { min-height: 2lh; }
  }
  /* Laptops: the countdown stands beside the words and the button, a size smaller. */
  @media (min-width: 960px) and (max-height: 860px) {
    .launch { --cd-n: 1.35rem; --cd-u: 9.5px; --cd-w: 52px; --cd-pad: 2px;
      display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 20px; }
    .launch-top { grid-column: 1 / -1; }
    .launch-note { grid-column: 1; }
    .launch-row { display: contents; }
    .launch-row .btn { grid-column: 1; justify-self: start; margin-top: 12px; }
    .launch .cd { grid-column: 2; grid-row: 2 / span 2; align-self: end; }
  }
  .cd-card:nth-child(2) { --c: var(--c1); }
  .cd-card:nth-child(3) { --c: var(--c2); }
  .cd-card:nth-child(4) { --c: var(--c3); }
  @media (max-width: 959.98px) {
    .cd { display: none !important; }
    .launch { padding: 18px 16px; }
    /* The game's logo first, as the block's title, then the date. */
    .launch-top { flex-direction: column; align-items: flex-start; gap: 10px; }
    .launch-name { order: -1; }
    .launch-name .gt-robot { width: 132px; margin: -8px 0 -6px -8px; }
  }

  /* Phones and tablets: all three games named under the masthead, one tap away. */
  .jump { display: none; }
  @media (max-width: 959.98px) {
    .jump { display: block; }
    .jump ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
    .jump a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 4px 12px 4px 4px; border: 1px solid var(--line-strong); border-radius: 4px; color: var(--text); text-decoration: none; font-size: 15px; font-weight: 600; }
    .jump span { display: grid; place-items: center; min-width: 30px; height: 30px; border-radius: 3px; font: 700 15px/1 var(--studio); color: var(--g-bg); background: var(--g-accent); }
    .jump a:hover { border-color: var(--g-accent); color: var(--text); }
  }

  /* ---------- The stage: three panels, one open ---------- */
  .stage { padding-bottom: clamp(40px, 5vw, 72px); }
  /* Panels move only around a visitor's own gesture: while the script opens one (.anim),
     or while someone points at or tabs through the stage (--k: 1); loading, resizing or
     a screenshot never catches a panel mid-move. --dur is how long a panel takes to open. */
  .tri { --ease: cubic-bezier(.22, .61, .36, 1); --dur: .54s; --k: 0; }
  .tri:is(:hover, :focus-within), .tri.anim { --k: 1; }
  :where(.tp) { --open: 0; --pe: none; --sv: visible; --bv: hidden; }
  :where(.tp.is-open) { --open: 1; --pe: auto; --sv: hidden; --bv: visible; }
  .tp { position: relative; isolation: isolate; overflow: hidden; min-width: 0; border-radius: 4px; scroll-margin-top: 12px; }

  .tp-art { position: absolute; inset: 0; z-index: -1; overflow: hidden; background: var(--g-bg); }
  .tp-art :is(img, video) {
    position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover;
    object-position: calc(var(--x0) + (var(--x1) - var(--x0)) * var(--open)) calc(var(--y0) + (var(--y1) - var(--y0)) * var(--open));
  }
  .tp-art img {
    --t: calc(var(--k) * var(--dur)) var(--ease);
    transition: opacity .8s, filter .35s, object-position var(--t), top var(--t), left var(--t), height var(--t), transform var(--t);
  }
  /* The loop covers the open Robot panel (the script sets its file and object-position);
     the still key art fades out behind it while it plays. */
  .tp-art video { opacity: 0; transition: opacity .8s; }
  @media (min-width: 960px) {
    .tp.has-video.is-open .tp-art video { opacity: 1; }
    .tp.has-video.is-open .tp-art img { opacity: 0; }
  }
  /* Slim panels keep their art lit in the middle and dark where the type sits;
     the open one is dark only under its copy. */
  .tp-art::before, .tp-art::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .tp-art::before {
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--g-bg) 78%, transparent) 0,
      color-mix(in srgb, var(--g-bg) 18%, transparent) 22%,
      color-mix(in srgb, var(--g-bg) 12%, transparent) 42%,
      color-mix(in srgb, var(--g-bg) 88%, transparent) 64%,
      var(--g-bg) 100%);
    opacity: calc(1 - var(--open));
    transition: opacity calc(var(--k) * .4s) ease;
  }
  .tp-art::after {
    --scrim: 50%;
    background:
      linear-gradient(0deg, var(--g-bg) 0%, color-mix(in srgb, var(--g-bg) 82%, transparent) 26%, transparent 60%),
      linear-gradient(90deg, color-mix(in srgb, var(--g-bg) 92%, transparent) 0%, color-mix(in srgb, var(--g-bg) var(--scrim), transparent) 34%, transparent 58%);
    opacity: var(--open);
    transition: opacity calc(var(--k) * var(--dur)) var(--ease);
  }
  /* The Robot's laser crosses the key art at title height: a denser scrim under the copy.
     Zoomed in (open, phones), its art ends above the panel's foot, so its edge fades out. */
  .theme-robot .tp-art::after { --scrim: 78%; }
  /* Race: the cars' name tags run under the one-line title. */
  .theme-race .tp-art::after { --scrim: 74%; }
  .theme-robot .tp-art img { -webkit-mask-image: linear-gradient(180deg, #000 82%, transparent); mask-image: linear-gradient(180deg, #000 82%, transparent); }
  /* As a spine its top edge sits below the number, so it fades in there too. */
  @media (min-width: 960px) {
    .theme-robot .tp-art img {
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 14%, #000 82%, transparent);
      mask-image: linear-gradient(180deg, transparent, #000 14%, #000 82%, transparent);
    }
  }
  .tp-cover { display: none; }

  .tp-body { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; container-type: inline-size; }
  .tp-meta { margin: 0; }
  .tp-body .label { margin: 0; display: flex; gap: 12px; align-items: baseline; }
  .tp-idx { color: var(--g-dim); }
  /* Each game's own name (GameTitle), on one line, as wide as the copy allows. */
  .tp-title { margin: 2px 0; line-height: 1; letter-spacing: 0; max-width: 100%; }
  .tp-title a { display: block; text-decoration: none; border-radius: 2px; }
  .tp-title a:hover { opacity: .9; }
  .theme-robot .tp-title .gt-robot { width: clamp(230px, 21vw, 320px); margin: -14px 0 -12px -10px; }
  .theme-murder .tp-title { font-size: min(2.9rem, 100cqi / 11.6); }
  .theme-race .tp-title { font-size: min(1.7rem, 100cqi / 16.8); margin-block: 8px 4px; }
  .tp-tag { text-wrap: pretty; margin: 0; font-size: clamp(1.12rem, 1.4vw, 1.3rem); line-height: 1.35; font-weight: 600; color: var(--g-text); max-width: 24em; }
  .tp-pitch { text-wrap: pretty; margin: 0; color: var(--g-dim); max-width: 30em; }
  .tp-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 6px; }
  .more { font-size: 15px; font-weight: 600; }
  .tp .chips { list-style: none; margin: 0; padding: 2px 0 0; }
  .tp .chips span { color: var(--g-dim); border-color: color-mix(in srgb, var(--g-dim) 38%, transparent); }
  .tp :focus-visible { outline-color: var(--g-accent); }
  .tp-spine { display: none; }

  .tp-pause {
    position: absolute; right: 18px; top: 20px; width: 38px; height: 38px; border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--g-text) 45%, transparent); background: color-mix(in srgb, var(--g-bg) 55%, transparent);
    color: var(--g-text); cursor: pointer; display: none;
  }
  /* Only where the loop plays: a window narrowed (or a tablet turned) below 960 px
     hides the video, and its button goes with it. */
  @media (min-width: 960px) {
    .tp.has-video.is-open .tp-pause { display: block; z-index: 4; }
  }
  .tp-pause::before { content: ''; position: absolute; inset: 0; margin: auto; width: 10px; height: 12px; border-inline: 3px solid currentColor; box-sizing: border-box; }
  .tp-pause.is-paused::before { width: 0; height: 0; border: 0; border-left: 11px solid currentColor; border-block: 7px solid transparent; margin-left: 15px; }
  .tp-pause:hover { border-color: var(--g-text); }

  /* Each game's rule along the top of its panel: Robot's five letter colours, Murder's
     gold double rule, Race's chequered strip. Opening a panel plays its own gesture. */
  .tp::after { content: ''; position: absolute; inset: 0 0 auto; z-index: 3; pointer-events: none; }
  .theme-robot::after { height: 4px; background: linear-gradient(90deg, #ff7f8e 0 20%, #ffc857 0 40%, #74de78 0 60%, #5ce1e6 0 80%, #b98cff 0); }
  .theme-murder::after { height: 6px; border-block: 1.5px solid var(--g-accent); }
  .theme-race::after { height: 8px; background: repeating-conic-gradient(#e9edf5 0 25%, #0a0d13 0 50%) 0 0 / 8px 8px; }
  @media (prefers-reduced-motion: no-preference) {
    .theme-robot.opening::after { animation: rule-steps .6s steps(5, jump-start) both; }
    .theme-murder.opening::after { animation: rule-centre .9s cubic-bezier(.6, 0, .2, 1) both; }
    .theme-race.opening::after { animation: rule-wipe .42s cubic-bezier(.3, 0, .1, 1) both; }
  }
  @keyframes rule-steps { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  @keyframes rule-centre { from { clip-path: inset(0 50%); } to { clip-path: inset(0); } }
  @keyframes rule-wipe { from { clip-path: inset(0 0 0 100%); } to { clip-path: inset(0); } }

  /* Wide screens: one open panel and two spines, all three as tall as the tallest copy
     needs (every body keeps its width and its height, open or not), never shorter than
     the stage. A spine opens on a click or tap only; pointing at it or tabbing to it lights
     it up (art, top rule and "More") without moving anything. Without the script, a
     spine's "More" link opens its panel through :target. */
  @media (min-width: 960px) {
    .tri { --stage-h: clamp(540px, calc(100svh - 360px), 760px); display: flex; gap: 8px; min-height: var(--stage-h); }
    .tp {
      display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr);
      flex: calc(1 + 3.4 * var(--open)) 1 0; min-width: 170px;
      transition: flex-grow calc(var(--k) * var(--dur)) var(--ease);
    }
    html:not(.js) :where(.tri:has(.tp:target) .tp) { --open: 0; --pe: none; --sv: visible; --bv: hidden; }
    html:not(.js) :where(.tri .tp:target) { --open: 1; --pe: auto; --sv: hidden; --bv: visible; }

    /* The Robot's key art is a wide panorama, always drawn to the panel's height, so it
       is placed by two of its own points rather than by object-position: point --a of
       the art (a share of its width) sits at --r across the panel. As a spine (0) the
       floating head (75% across the art) is centred, a little smaller and below the
       number; open (1) the art zooms in and the green robot (44% across) stands just
       right of the copy, never past the panel's edge. --half is half the robot's width. */
    .theme-robot {
      --t0: 60px; --h0: min(100%, 520px); --r0: 50%; --a0: 75%;
      --t1: -43%; --h1: 125%; --a1: 44.3%; --half: calc(var(--stage-h) * .195);
      --r1: max(70%, min(calc(clamp(380px, 34vw, 540px) - clamp(14px, 1.5vw, 22px) + var(--half)), calc(100% - var(--half))));
    }
    .theme-robot .tp-art img {
      inset: auto; width: auto; max-width: none;
      top: calc(var(--t0) + (var(--t1) - var(--t0)) * var(--open));
      height: calc(var(--h0) + (var(--h1) - var(--h0)) * var(--open));
      left: calc(var(--r0) + (var(--r1) - var(--r0)) * var(--open));
      transform: translateX(calc(-1 * (var(--a0) + (var(--a1) - var(--a0)) * var(--open))));
    }

    .tp-body, .tp-spine { grid-area: 1 / 1; }
    /* The open panel's copy. A closed panel's copy is hidden (out of the tab order and the
       accessibility tree) once it has faded; its spine stands in for it. */
    .tp-body {
      align-self: end; z-index: 1;
      width: clamp(380px, 34vw, 540px); padding: clamp(28px, 3vw, 44px) clamp(28px, 3vw, 44px) clamp(28px, 2.8vw, 40px);
      visibility: var(--bv); pointer-events: var(--pe);
      transition: visibility 0s linear calc(var(--k) * (1 - var(--open)) * .2s);
    }
    /* Opening, the lines come in one after another while the panel widens; closing, they
       leave at once. */
    .tp-body > * {
      opacity: var(--open); transform: translateY(calc((1 - var(--open)) * 10px));
      transition:
        opacity calc(var(--k) * (.12s + var(--open) * .22s)) ease-out calc(var(--k) * var(--open) * (.12s + var(--i, 0) * .05s)),
        transform calc(var(--k) * (.12s + var(--open) * .36s)) var(--ease) calc(var(--k) * var(--open) * (.12s + var(--i, 0) * .05s));
    }
    .tp-body > :nth-child(2) { --i: 1; }
    .tp-body > :nth-child(3) { --i: 2; }
    .tp-body > :nth-child(4) { --i: 3; }
    .tp-body > :nth-child(5) { --i: 4; }
    .tp-body > :nth-child(6) { --i: 5; }
    .tp-body > :nth-child(n + 7) { --i: 6; }
    /* Opened from the keyboard: the copy is there at once, so focus never lands on a line
       that is still fading in. */
    .tri.kbd .tp-body > * { transition-duration: .16s !important; transition-delay: 0s !important; }

    .tp-spine {
      z-index: 2; display: flex; flex-direction: column; min-height: 0; padding: 20px 16px 18px;
      opacity: calc(1 - var(--open)); visibility: var(--sv);
      /* Out quickly as its panel opens; back in only once the closing copy has gone. */
      transition:
        opacity calc(var(--k) * (.14s + (1 - var(--open)) * .3s)) ease calc(var(--k) * (1 - var(--open)) * .34s),
        visibility 0s linear calc(var(--k) * var(--open) * .14s);
    }
    .tp-spine-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
    .tp-no { font: 700 64px/.8 var(--studio); color: transparent; -webkit-text-stroke: 1.5px var(--g-accent); letter-spacing: .01em; }
    .theme-murder .tp-no { font: 700 60px/.8 var(--g-title); -webkit-text-stroke-width: 1.25px; }
    .theme-race .tp-no { font: 400 34px/1 var(--g-title); -webkit-text-stroke-width: 1px; padding-top: 4px; }
    .tp-glyph { width: 30px; height: auto; color: var(--g-accent); margin-top: 2px; }
    /* The game's own name turned on its side, reading up the spine, as large as the room
       it has allows (cqh, cqw: shares of its own box), so a short stage, larger text or
       wider spacing shrinks it instead of cutting it off. */
    .tp-vname { flex: 1 1 0; min-height: 0; margin: 14px 0; position: relative; container-type: size; overflow: hidden; font-size: 16px; line-height: 1; }
    .tp-vname > .gt {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(-90deg); white-space: nowrap;
      filter: drop-shadow(0 1px 8px color-mix(in srgb, var(--g-bg) 85%, transparent));
    }
    /* Room for the reader's own text spacing too (letters +.12em, words +.16em). */
    .theme-murder .tp-vname > .gt { font-size: min(44px, 100cqh / 13.8, 70cqw); }
    .theme-race .tp-vname > .gt { font-size: min(30px, 100cqh / 18.4, 40cqw); }
    .theme-robot .tp-vname > .gt-robot { width: min(300px, 100cqh, 160cqw); max-width: none; }
    .tp-foot { display: flex; flex-direction: column; align-items: stretch; gap: 10px; }
    .tp-genre { margin: 0; font: 500 11px/1.35 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--g-accent); hyphens: manual; overflow-wrap: break-word; }
    .tp-fact { margin: 0 0 2px; color: var(--g-dim); font-size: 14px; line-height: 1.3; }
    .tp-fact b { display: block; font: 700 30px/1 var(--studio); color: var(--g-text); margin-bottom: 2px; }
    .theme-murder .tp-fact b { font: 700 28px/1.05 var(--g-title); }
    .theme-race .tp-fact b { font: 400 20px/1.3 var(--g-title); }
    .tp-cta { position: relative; z-index: 2; min-height: 44px; padding: 8px 12px; gap: 8px; font-size: 14px; line-height: 1.2; text-align: left; justify-content: flex-start; }
    .tp-cta svg { width: 18px; height: 18px; }
    /* "More" opens the panel; its hit area covers the whole spine, under the store button. */
    .tp-more { display: inline-flex; align-items: center; gap: 4px; align-self: flex-start; margin: 0; padding: 4px 0; border: 0; background: none; font: 600 14px/1 var(--body); color: var(--g-text) !important; text-decoration: none; cursor: pointer; transition: color .25s; }
    .tp-more svg { width: 14px; height: 14px; transition: transform .25s var(--ease); }
    .tp-more::after { content: ''; position: absolute; inset: 0; z-index: 1; cursor: pointer; }
    .tp-more:focus-visible { outline: none; }
    .tp-more:focus-visible::after { outline: 2px solid var(--g-accent); outline-offset: -5px; border-radius: 4px; }
    /* A closed panel answers the pointer or the keyboard without moving: its art brightens,
       its top rule lights up and "More" takes the game's colour. */
    .tp::after { opacity: calc(.55 + .45 * var(--open)); transition: opacity .3s; }
    .tp:not(.is-open):is(:hover, :focus-within)::after { opacity: 1; }
