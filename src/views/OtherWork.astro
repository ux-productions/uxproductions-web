---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { OTHER_WORK } from '../data/other';
import { localize, t, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const sv = lang === 'sv';
const title = sv ? 'Andra projekt: lärappar för skolan' : 'Other work: learning apps for schools';
const description = sv
  ? 'Lärappar som UX Productions har utvecklat tillsammans med Alfamax för svenska skolor: ordpusslet Skattjakten och AHA - en eller ett?, där du lär dig svenska ord.'
  : 'Learning apps UX Productions developed with Alfamax for Swedish schools: the word puzzle Skattjakten and AHA - en eller ett?, which teaches Swedish words.';
---
<Base title={title} description={description} lang={lang} path="/games/other-work/" bilingual>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label={sv ? 'Brödsmulor' : 'Breadcrumb'}><a href={localize('/games/', lang)}>{s.nav.games}</a> / {s.otherWork}</nav>
      <h1>{s.otherWork}</h1>
      <p>{sv ? 'Lärappar vi har byggt tillsammans med pedagoger.' : 'Learning apps we built together with educators.'}</p>
    </header>
    <div class="work-list">
      {OTHER_WORK.map((w, i) => (
        <article class="work" id={w.id}>
          {w.image && <Picture src={w.image} alt={w.title} widths={[480, 800]} sizes="(max-width: 800px) 100vw, 460px" formats={['avif', 'webp']} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />}
          <div>
            <h2>{w.title}</h2>
            <p class="dim">{w.text[lang]}</p>
            {w.audience && <p class="meta-list"><b>{sv ? 'Målgrupp' : 'Audience'}:</b> {w.audience[lang]}</p>}
            {w.credits && (
              <ul class="meta-list credits">
                {w.credits.map((c) => <li><b>{c.role[lang]}:</b> {c.name}</li>)}
              </ul>
            )}
            <div class="btns">
              {w.links.map((l) => <a class="btn" href={l.url} rel={l.url.startsWith('http') ? 'noopener' : undefined}>{l.label[lang]}</a>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .work-list { display: grid; gap: 48px; padding-block: 32px 88px; }
  .work { display: grid; grid-template-columns: minmax(0, 460px) minmax(0, 1fr); gap: 32px; align-items: start; scroll-margin-top: 24px; }
  .work img { border-radius: var(--radius); border: 1px solid var(--line); }
  .work h2 { margin-bottom: 12px; }
  .credits { list-style: none; padding: 0; margin: 0 0 16px; }
  @media (max-width: 760px) { .work { grid-template-columns: 1fr; gap: 16px; } }
</style>
